<fluence:FluenceWindow
    x:Class="Fluence.Wpf.Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluence="http://schemas.fluencewpf.com"
    Title="Fluence.Wpf - Control Gallery"
    Width="1200"
    Height="970"
    MinWidth="1200"
    MinHeight="970"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    CornerStyle="Round"
    ExtendsContentIntoTitleBar="True"
    RenderOptions.BitmapScalingMode="HighQuality"
    SystemBackdropType="Mica"
    UseLayoutRounding="True">

    <fluence:FluenceWindow.TitleBar>
        <fluence:TitleBar
            x:Name="ShellTitleBar"
            Height="{Binding TitleBarHeight, RelativeSource={RelativeSource AncestorType=fluence:FluenceWindow}}"
            BackRequested="ShellTitleBar_BackRequested"
            PaneToggleRequested="ShellTitleBar_PaneToggleRequested"
            SizeChanged="TitleBarLayout_SizeChanged">
            <fluence:AutoSuggestBox
                x:Name="NavSearchBox"
                Width="320"
                MinWidth="320"
                MaxWidth="475"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                PlaceholderText="Search controls and samples..."
                QuerySubmitted="NavSearchBox_QuerySubmitted"
                TextChanged="NavSearchBox_TextChanged"
                TextMemberPath="Title"
                UpdateTextOnSelect="True"
                WindowChrome.IsHitTestVisibleInChrome="True">
                <fluence:AutoSuggestBox.QueryIcon>
                    <fluence:FontIcon Glyph="&#xE721;" IconFontSize="12" />
                </fluence:AutoSuggestBox.QueryIcon>
            </fluence:AutoSuggestBox>
        </fluence:TitleBar>
    </fluence:FluenceWindow.TitleBar>

    <Grid x:Name="ShellRoot" ClipToBounds="True">
        <fluence:NavigationView
            x:Name="DemoNav"
            Background="Transparent"
            IsBackButtonVisible="True"
            IsBackEnabled="True"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="True"
            PaneDisplayMode="Left"
            SelectedIndex="0">
            <fluence:NavigationView.FooterMenuItems>
                <fluence:NavigationViewItem
                    x:Name="SettingsNavigationItem"
                    AutomationProperties.Name="Settings"
                    Content="Settings"
                    Tag="settings"
                    ToolTip="Settings">
                    <fluence:NavigationViewItem.Icon>
                        <fluence:FontIcon Glyph="&#xE713;" IconFontSize="16" />
                    </fluence:NavigationViewItem.Icon>
                </fluence:NavigationViewItem>
            </fluence:NavigationView.FooterMenuItems>

            <!--
                The gallery pages are Page objects, as the WinUI Gallery's own pages are, and WPF
                only lets a Window or a Frame parent one. The shell therefore hosts them in a
                Frame with its navigation chrome hidden; MainWindow keeps owning the back stack,
                so the frame's own journal is cleared after every navigation. The frame is set as
                the navigation view's Content: NavigationView derives from Selector, so a bare
                child would join Items instead.
            -->
            <fluence:NavigationView.Content>
                <Frame
                    x:Name="PageFrame"
                    Focusable="False"
                    NavigationUIVisibility="Hidden" />
            </fluence:NavigationView.Content>
        </fluence:NavigationView>
    </Grid>
</fluence:FluenceWindow>
