    <Style
        x:Key="SectionDescriptionStyle"
        BasedOn="{StaticResource {x:Type TextBlock}}"
        TargetType="{x:Type TextBlock}">
        <!--  WinUI Gallery parity: ItemPage.xaml's descriptionText TextBlock (WinUIGallery/Pages/ItemPage.xaml:53-61) uses BodyTextBlockStyle, which does not override Foreground, so it resolves to the page's default (primary) text color rather than a secondary/dimmed one.  -->
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="{DynamicResource DemoPageDescriptionMargin}" />
