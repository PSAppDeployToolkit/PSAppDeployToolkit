    <!--  WinUI 3 Gallery ControlPage content margin parity: left and top match the Gallery's ItemPage.xaml root margin; the right side is trimmed 1px narrower than the left to leave room for the page ScrollViewer's Auto vertical scrollbar gutter (GalleryPageScrollViewerStyle) without shifting the visible card's right edge. The bottom is 0: this margin sits on the content Grid whose last row is the scroll host, so a bottom inset here is dead space under the scroller rather than trailing room after the last card. Trailing room belongs on the scrolling content (DemoPageScrollContentMargin), where it scrolls with the samples.  -->
    <Thickness x:Key="DemoPageContentMargin">45,24,44,0</Thickness>
    <!--  The same page margin for a page whose root IS the scroll host (GalleryHomePage), so this margin lands on the scrolling content rather than on a Grid above it. The bottom inset is the Gallery's trailing room after the last card, and here it scrolls with the content, so it is carried rather than dropped.  -->
    <Thickness x:Key="DemoPageStackContentMargin">45,24,44,48</Thickness>
    <Thickness x:Key="DemoPageDescriptionMargin">0,0,0,24</Thickness>
    <!--
        Scroll-host geometry, measured against the WinUI 3 Gallery at 150% DPI. The Gallery puts its
        page ScrollViewer outside the ItemPage content margin entirely, so the rail rides the window
        frame at the far right of the navigation view's content and the sample cards keep the page
        margin. Here the scroll host lives inside the content Grid, so it gives the whole right page
        margin back (DemoPageScrollHostMargin) to reach the frame, and the scrolling content pays the
        same amount again (DemoPageScrollContentMargin) so the cards still end where the page title
        does. The scrolling content also carries the Gallery's 48 dip bottom inset, so the trailing
        room after the last card scrolls with the samples instead of standing as dead space under the
        scroll host. The Colors page uses the same host margin for its per-section scroll hosts, with
        DemoColorSectionContentMargin as its matching gutter, so every page's rail sits in the same
        place.
    -->
    <Thickness x:Key="DemoPageScrollHostMargin">0,0,-44,0</Thickness>
    <Thickness x:Key="DemoPageScrollContentMargin">0,0,44,48</Thickness>
    <Thickness x:Key="DemoCompactStackSpacingMargin">0,0,0,8</Thickness>
