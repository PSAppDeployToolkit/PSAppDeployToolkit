<UserControl
    x:Class="Fluence.Wpf.Demo.Pages.GalleryNavigationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluence="http://schemas.fluencewpf.com"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Fluence.Wpf.Demo.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="900"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <fluence:SmoothScrollViewer Style="{StaticResource GalleryPageScrollViewerStyle}">
        <StackPanel Style="{StaticResource GalleryPageContentStackStyle}">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Navigation" />
            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="NavigationView organizes top-level destinations and can place the pane on the left, across the top, or in compact left mode." />


            <ContentControl x:Name="DemoSampleSlot01DemoContentHost" Visibility="Collapsed">
                <Border Height="320">
                    <fluence:NavigationView
                        x:Name="LeftNavigationDemo"
                        ItemInvoked="NavigationDemo_ItemInvoked"
                        PaneDisplayMode="Left">
                        <fluence:NavigationView.PaneHeader>
                            <TextBlock
                                Margin="{DynamicResource DemoNavigationHeaderMargin}"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Navigation" />
                        </fluence:NavigationView.PaneHeader>
                        <fluence:NavigationViewItem
                            x:Name="LeftNavigationHomeItem"
                            Content="Home"
                            IsSelected="True">
                            <fluence:NavigationViewItem.Icon>
                                <fluence:FontIcon Glyph="&#xE80F;" IconFontSize="16" />
                            </fluence:NavigationViewItem.Icon>
                        </fluence:NavigationViewItem>
                        <fluence:NavigationViewItem Content="Files">
                            <fluence:NavigationViewItem.Icon>
                                <fluence:FontIcon Glyph="&#xE8B7;" IconFontSize="16" />
                            </fluence:NavigationViewItem.Icon>
                        </fluence:NavigationViewItem>
                        <fluence:NavigationViewItem Content="Reports">
                            <fluence:NavigationViewItem.Icon>
                                <fluence:FontIcon Glyph="&#xE9D9;" IconFontSize="16" />
                            </fluence:NavigationViewItem.Icon>
                        </fluence:NavigationViewItem>
                    </fluence:NavigationView>
                </Border>
            </ContentControl>
            <local:DemoSampleControl SampleDescription="Use a left pane when the app has several persistent destinations and enough horizontal space." />


            <ContentControl x:Name="DemoSampleSlot02DemoContentHost" Visibility="Collapsed">
                <Border Height="240">
                    <fluence:NavigationView
                        x:Name="TopNavigationDemo"
                        Header="Insights"
                        ItemInvoked="NavigationDemo_ItemInvoked"
                        PaneDisplayMode="Top">
                        <fluence:NavigationViewItem
                            x:Name="TopNavigationOverviewItem"
                            Content="Overview"
                            IsSelected="True">
                            <fluence:NavigationViewItem.Icon>
                                <fluence:FontIcon Glyph="&#xE9D2;" IconFontSize="16" />
                            </fluence:NavigationViewItem.Icon>
                        </fluence:NavigationViewItem>
                        <fluence:NavigationViewItem Content="Activity">
                            <fluence:NavigationViewItem.Icon>
                                <fluence:FontIcon Glyph="&#xE7F4;" IconFontSize="16" />
                            </fluence:NavigationViewItem.Icon>
                        </fluence:NavigationViewItem>
                        <fluence:NavigationViewItem Content="Settings">
                            <fluence:NavigationViewItem.Icon>
                                <fluence:FontIcon Glyph="&#xE713;" IconFontSize="16" />
                            </fluence:NavigationViewItem.Icon>
                        </fluence:NavigationViewItem>
                    </fluence:NavigationView>
                </Border>
            </ContentControl>
            <local:DemoSampleControl SampleDescription="Use top navigation for a small set of peer destinations that should leave the full width for content." />


            <ContentControl x:Name="DemoSampleSlot03DemoContentHost" Visibility="Collapsed">
                <Border
                    Height="300"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="{DynamicResource DemoSingleBorderThickness}">
                    <fluence:NavigationView
                        x:Name="CompactNavigationDemo"
                        IsBackButtonVisible="True"
                        IsBackEnabled="{Binding IsChecked, Source={x:Reference BackEnabledToggle}}"
                        IsPaneOpen="False"
                        IsPaneToggleButtonVisible="True"
                        ItemInvoked="NavigationDemo_ItemInvoked"
                        PaneDisplayMode="LeftCompact">
                        <fluence:NavigationView.PaneFooter>
                            <fluence:NavigationViewItem x:Name="CompactNavigationFooterItem" Content="Settings">
                                <fluence:NavigationViewItem.Icon>
                                    <fluence:FontIcon Glyph="&#xE713;" IconFontSize="16" />
                                </fluence:NavigationViewItem.Icon>
                            </fluence:NavigationViewItem>
                        </fluence:NavigationView.PaneFooter>
                        <fluence:NavigationViewItem
                            x:Name="CompactNavigationDashboardItem"
                            Content="Dashboard"
                            IsSelected="True">
                            <fluence:NavigationViewItem.Icon>
                                <fluence:FontIcon Glyph="&#xE80F;" IconFontSize="16" />
                            </fluence:NavigationViewItem.Icon>
                        </fluence:NavigationViewItem>
                        <fluence:NavigationViewItem Content="Messages">
                            <fluence:NavigationViewItem.Icon>
                                <fluence:FontIcon Glyph="&#xE8BD;" IconFontSize="16" />
                            </fluence:NavigationViewItem.Icon>
                        </fluence:NavigationViewItem>
                    </fluence:NavigationView>
                </Border>
            </ContentControl>
            <ContentControl x:Name="DemoSampleSlot03RightRailContentHost" Visibility="Collapsed">
                <StackPanel>
                    <fluence:CheckBox
                        x:Name="BackEnabledToggle"
                        Content="Back enabled"
                        IsChecked="True" />
                </StackPanel>
            </ContentControl>
            <local:DemoSampleControl SampleDescription="Use compact mode to preserve space, and enable the back button when the current view can navigate backward." />


            <ContentControl x:Name="DemoSampleSlot04DemoContentHost" Visibility="Collapsed">
                <Border Height="260">
                    <fluence:NavigationView
                        Header="Inbox"
                        IsPaneOpen="True"
                        PaneDisplayMode="Left">
                        <fluence:NavigationViewItem Content="Inbox" IsSelected="True">
                            <fluence:NavigationViewItem.Icon>
                                <fluence:FontIcon Glyph="&#xE715;" IconFontSize="16" />
                            </fluence:NavigationViewItem.Icon>
                            <fluence:NavigationViewItem.InfoBadge>
                                <fluence:InfoBadge Value="12" />
                            </fluence:NavigationViewItem.InfoBadge>
                        </fluence:NavigationViewItem>
                        <fluence:NavigationViewItem Content="Approvals">
                            <fluence:NavigationViewItem.Icon>
                                <fluence:FontIcon Glyph="&#xE73E;" IconFontSize="16" />
                            </fluence:NavigationViewItem.Icon>
                            <fluence:NavigationViewItem.InfoBadge>
                                <fluence:InfoBadge BadgeStyle="{x:Static fluence:InfoBadgeStyle.Caution}" />
                            </fluence:NavigationViewItem.InfoBadge>
                        </fluence:NavigationViewItem>
                        <fluence:NavigationViewItem Content="Alerts">
                            <fluence:NavigationViewItem.Icon>
                                <fluence:FontIcon Glyph="&#xE7BA;" IconFontSize="16" />
                            </fluence:NavigationViewItem.Icon>
                            <fluence:NavigationViewItem.InfoBadge>
                                <fluence:InfoBadge BadgeStyle="{x:Static fluence:InfoBadgeStyle.Critical}" Value="2" />
                            </fluence:NavigationViewItem.InfoBadge>
                        </fluence:NavigationViewItem>
                    </fluence:NavigationView>
                </Border>
            </ContentControl>
            <local:DemoSampleControl SampleDescription="Use InfoBadge in NavigationViewItem to call attention to item state without changing the item label." />


            <ContentControl x:Name="DemoSampleSlot05DemoContentHost" Visibility="Collapsed">
                <fluence:StackPanel HorizontalAlignment="Left" Spacing="8">
                    <fluence:BreadcrumbBar x:Name="DemoBreadcrumbBar" ItemClicked="DemoBreadcrumbBar_ItemClicked" />
                    <TextBlock
                        x:Name="BreadcrumbResultLabel"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Click a crumb to navigate up" />
                </fluence:StackPanel>
            </ContentControl>
            <local:DemoSampleControl SampleDescription="Use BreadcrumbBar to show the path to the current location and jump back to any ancestor." />


            <ContentControl x:Name="DemoSampleSlot06DemoContentHost" Visibility="Collapsed">
                <fluence:StackPanel HorizontalAlignment="Left" Spacing="8">
                    <fluence:PipsPager
                        x:Name="DemoPipsPager"
                        NextButtonVisibility="Visible"
                        NumberOfPages="8"
                        PreviousButtonVisibility="Visible"
                        SelectedIndexChanged="DemoPipsPager_SelectedIndexChanged" />
                    <TextBlock
                        x:Name="PipsPagerResultLabel"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Page 1 of 8" />
                </fluence:StackPanel>
            </ContentControl>
            <local:DemoSampleControl SampleDescription="Use PipsPager for compact page indication and switching, as in carousels and onboarding flows." />
        </StackPanel>
    </fluence:SmoothScrollViewer>
</UserControl>
