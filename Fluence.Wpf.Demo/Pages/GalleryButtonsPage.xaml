<Page
    x:Class="Fluence.Wpf.Demo.Pages.GalleryButtonsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluence="http://schemas.fluencewpf.com"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Fluence.Wpf.Demo.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="900"
    d:DesignWidth="900"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <!--
        Buttons gallery page. Pattern used by most pages:
        * A Grid whose header and description rows are locked (Auto) and whose last row (*)
        holds a SmoothScrollViewer over a StackPanel of DemoSampleControl "cards", so only the
        samples scroll under the fixed page header, matching the WinUI 3 Gallery.
        * Live controls for each card live in hidden ContentControl slots named
        DemoSampleSlotNN...Host; the code-behind constructor calls
        DemoSamplePageWiring.Apply(...) to move them into the cards and attach source.
        See Fluence.Wpf.Demo/README.md and Pages/DemoSamplePageWiring.cs.
    -->
    <Grid x:Name="PageRoot" Style="{StaticResource GalleryPageRootStyle}">
        <Grid x:Name="PageContent" Style="{StaticResource GalleryPageContentGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <local:GalleryPageHeader DocsAnchor="basic-actions" Title="Buttons" />
            <TextBlock Grid.Row="1" Style="{StaticResource SectionDescriptionStyle}" Text="Buttons initiate actions, open menus, navigate as links, or hold a checked state." />

            <fluence:SmoothScrollViewer
                Grid.Row="2"
                Margin="{DynamicResource DemoPageScrollHostMargin}"
                Style="{StaticResource GalleryPageScrollViewerStyle}">
                <StackPanel Margin="{DynamicResource DemoPageScrollContentMargin}">


                    <ContentControl x:Name="DemoSampleSlot01DemoContentHost" Visibility="Collapsed">
                        <fluence:Button
                            x:Name="StandardButton"
                            Content="Standard XAML button"
                            IsEnabled="{Binding IsChecked, Source={x:Reference ButtonEnableCheckBox}}" />
                    </ContentControl>
                    <ContentControl x:Name="DemoSampleSlot01RightRailContentHost" Visibility="Collapsed">
                        <fluence:CheckBox
                            x:Name="ButtonEnableCheckBox"
                            Content="Enable button"
                            IsChecked="True" />
                    </ContentControl>
                    <local:DemoSampleControl SampleDescription="A simple Button with text content." />


                    <ContentControl x:Name="DemoSampleSlot02DemoContentHost" Visibility="Collapsed">
                        <fluence:Button
                            x:Name="GraphicalButton"
                            Width="50"
                            Height="50"
                            MinWidth="50"
                            Padding="0"
                            AutomationProperties.Name="Pie"
                            Click="GraphicalButton_Click">
                            <Image
                                Width="36"
                                Height="36"
                                AutomationProperties.Name="Slice"
                                Source="pack://application:,,,/Fluence.Wpf.Demo;component/Resources/SampleMedia/Slices.png" />
                        </fluence:Button>
                    </ContentControl>
                    <ContentControl x:Name="DemoSampleSlot02OutputContentHost" Visibility="Collapsed">
                        <TextBlock x:Name="GraphicalButtonOutputText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </ContentControl>
                    <local:DemoSampleControl SampleDescription="A Button with graphical content." />


                    <ContentControl x:Name="DemoSampleSlot03DemoContentHost" Visibility="Collapsed">
                        <WrapPanel VerticalAlignment="Center">
                            <fluence:Button
                                Margin="{DynamicResource DemoControlGroupItemMargin}"
                                Appearance="Accent"
                                Content="Accent style button" />
                            <fluence:Button
                                Margin="{DynamicResource DemoControlGroupItemMargin}"
                                Appearance="Subtle"
                                Content="Subtle style button" />
                        </WrapPanel>
                    </ContentControl>
                    <local:DemoSampleControl SampleDescription="Built-in appearances applied to Button: Accent for the primary action, Subtle for low-emphasis commands." />


                    <ContentControl x:Name="DemoSampleSlot04DemoContentHost" Visibility="Collapsed">
                        <WrapPanel VerticalAlignment="Center">
                            <fluence:Button Margin="{DynamicResource DemoControlGroupItemMargin}" Content="Icon Left">
                                <fluence:Button.Icon>
                                    <fluence:FontIcon Glyph="&#xE774;" IconFontSize="14" />
                                </fluence:Button.Icon>
                            </fluence:Button>
                            <fluence:Button
                                Margin="{DynamicResource DemoControlGroupItemMargin}"
                                Content="Icon Right"
                                IconPlacement="Right">
                                <fluence:Button.Icon>
                                    <fluence:FontIcon Glyph="&#xE8D6;" IconFontSize="14" />
                                </fluence:Button.Icon>
                            </fluence:Button>
                            <fluence:Button
                                Margin="{DynamicResource DemoControlGroupItemMargin}"
                                Appearance="Subtle"
                                Content="Refresh">
                                <fluence:Button.Icon>
                                    <fluence:FontIcon Glyph="&#xE72C;" IconFontSize="14" />
                                </fluence:Button.Icon>
                            </fluence:Button>
                        </WrapPanel>
                    </ContentControl>
                    <local:DemoSampleControl SampleDescription="Place icons before or after text when the symbol helps the action scan faster." />


                    <ContentControl x:Name="DemoSampleSlot05DemoContentHost" Visibility="Collapsed">
                        <WrapPanel VerticalAlignment="Center">
                            <fluence:HyperlinkButton
                                Margin="{DynamicResource DemoControlGroupItemMargin}"
                                Content="Documentation"
                                NavigateUri="https://github.com/sintaxasn/Fluence.Wpf" />
                            <fluence:HyperlinkButton
                                Margin="{DynamicResource DemoControlGroupItemMargin}"
                                Content="Release notes"
                                NavigateUri="https://github.com/sintaxasn/Fluence.Wpf/releases" />
                            <fluence:HyperlinkButton
                                Margin="{DynamicResource DemoControlGroupItemMargin}"
                                Content="With icon"
                                NavigateUri="https://github.com/sintaxasn/Fluence.Wpf">
                                <fluence:HyperlinkButton.Icon>
                                    <fluence:FontIcon Glyph="&#xE71B;" IconFontSize="14" />
                                </fluence:HyperlinkButton.Icon>
                            </fluence:HyperlinkButton>
                            <fluence:HyperlinkButton
                                Margin="{DynamicResource DemoControlGroupItemMargin}"
                                Content="Disabled"
                                IsEnabled="False" />
                        </WrapPanel>
                    </ContentControl>
                    <local:DemoSampleControl SampleDescription="Use HyperlinkButton for lightweight navigation and related secondary actions." />


                    <ContentControl x:Name="DemoSampleSlot06DemoContentHost" Visibility="Collapsed">
                        <WrapPanel VerticalAlignment="Center">
                            <fluence:DropDownButton
                                x:Name="NewDropDownButton"
                                Margin="{DynamicResource DemoControlGroupItemMargin}"
                                Content="New">
                                <fluence:DropDownButton.Flyout>
                                    <StackPanel MinWidth="180" Margin="{DynamicResource DemoSampleInnerCardPadding}">
                                        <fluence:Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Appearance="Subtle"
                                            Click="NewItemButton_Click"
                                            Content="Document" />
                                        <fluence:Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Appearance="Subtle"
                                            Click="NewItemButton_Click"
                                            Content="Spreadsheet" />
                                        <fluence:Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Appearance="Subtle"
                                            Click="NewItemButton_Click"
                                            Content="Folder" />
                                    </StackPanel>
                                </fluence:DropDownButton.Flyout>
                            </fluence:DropDownButton>
                            <fluence:DropDownButton Margin="{DynamicResource DemoControlGroupItemMargin}" Content="Details">
                                <fluence:DropDownButton.Flyout>
                                    <StackPanel MaxWidth="260" Margin="{DynamicResource DemoSampleInnerCardPadding}">
                                        <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Project status" />
                                        <TextBlock
                                            Margin="{DynamicResource DemoTextTopGapMargin}"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="Flyout content can be any WPF content."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </fluence:DropDownButton.Flyout>
                            </fluence:DropDownButton>
                            <fluence:DropDownButton
                                Margin="{DynamicResource DemoControlGroupItemMargin}"
                                Content="Disabled"
                                IsEnabled="False">
                                <fluence:DropDownButton.Flyout>
                                    <TextBlock Margin="{DynamicResource DemoSampleInnerCardPadding}" Text="Unavailable" />
                                </fluence:DropDownButton.Flyout>
                            </fluence:DropDownButton>
                        </WrapPanel>
                    </ContentControl>
                    <local:DemoSampleControl SampleDescription="Use DropDownButton when all available actions live in the flyout." />


                    <ContentControl x:Name="DemoSampleSlot07DemoContentHost" Visibility="Collapsed">
                        <WrapPanel VerticalAlignment="Center">
                            <fluence:SplitButton
                                x:Name="SaveSplitButton"
                                Margin="{DynamicResource DemoControlGroupItemMargin}"
                                Content="Save">
                                <fluence:SplitButton.Flyout>
                                    <StackPanel MinWidth="180" Margin="{DynamicResource DemoSampleInnerCardPadding}">
                                        <fluence:Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Appearance="Subtle"
                                            Click="SaveOptionButton_Click"
                                            Content="Save as" />
                                        <fluence:Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Appearance="Subtle"
                                            Click="SaveOptionButton_Click"
                                            Content="Save a copy" />
                                        <fluence:Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Appearance="Subtle"
                                            Click="SaveOptionButton_Click"
                                            Content="Export" />
                                    </StackPanel>
                                </fluence:SplitButton.Flyout>
                            </fluence:SplitButton>
                            <fluence:SplitButton
                                x:Name="PublishSplitButton"
                                Margin="{DynamicResource DemoControlGroupItemMargin}"
                                Appearance="Accent"
                                Content="Publish">
                                <fluence:SplitButton.Flyout>
                                    <StackPanel MinWidth="180" Margin="{DynamicResource DemoSampleInnerCardPadding}">
                                        <fluence:Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Appearance="Subtle"
                                            Click="PublishOptionButton_Click"
                                            Content="Publish draft" />
                                        <fluence:Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Appearance="Subtle"
                                            Click="PublishOptionButton_Click"
                                            Content="Schedule publish" />
                                    </StackPanel>
                                </fluence:SplitButton.Flyout>
                            </fluence:SplitButton>
                            <fluence:SplitButton
                                Margin="{DynamicResource DemoControlGroupItemMargin}"
                                Content="Disabled"
                                IsEnabled="False">
                                <fluence:SplitButton.Flyout>
                                    <TextBlock Margin="{DynamicResource DemoSampleInnerCardPadding}" Text="Unavailable" />
                                </fluence:SplitButton.Flyout>
                            </fluence:SplitButton>
                        </WrapPanel>
                    </ContentControl>
                    <local:DemoSampleControl SampleDescription="Use SplitButton when there is one default action plus alternate actions in the flyout." />


                    <ContentControl x:Name="DemoSampleSlot08DemoContentHost" Visibility="Collapsed">
                        <WrapPanel VerticalAlignment="Center">
                            <fluence:RepeatButton
                                x:Name="RepeatCounterButton"
                                Margin="{DynamicResource DemoControlGroupItemMargin}"
                                Click="RepeatCounterButton_Click"
                                Content="Hold to repeat" />
                        </WrapPanel>
                    </ContentControl>
                    <ContentControl x:Name="DemoSampleSlot08OutputContentHost" Visibility="Collapsed">
                        <TextBlock
                            x:Name="RepeatButtonCountText"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Clicks: 0" />
                    </ContentControl>
                    <local:DemoSampleControl SampleDescription="Use RepeatButton when holding the pointer should raise Click repeatedly." />


                    <ContentControl x:Name="DemoSampleSlot09DemoContentHost" Visibility="Collapsed">
                        <WrapPanel VerticalAlignment="Center">
                            <fluence:ToggleButton
                                x:Name="WrapToggleButton"
                                Margin="{DynamicResource DemoControlGroupItemMargin}"
                                Checked="WrapToggleButton_CheckedChanged"
                                Content="Wrap text"
                                Unchecked="WrapToggleButton_CheckedChanged" />
                            <fluence:ToggleButton
                                x:Name="ThreeStateToggleButton"
                                Margin="{DynamicResource DemoControlGroupItemMargin}"
                                Content="Three-state"
                                IsThreeState="True" />
                            <fluence:ToggleButton
                                Margin="{DynamicResource DemoControlGroupItemMargin}"
                                Content="Disabled checked"
                                IsChecked="True"
                                IsEnabled="False" />
                        </WrapPanel>
                    </ContentControl>
                    <ContentControl x:Name="DemoSampleSlot09OutputContentHost" Visibility="Collapsed">
                        <TextBlock
                            x:Name="ToggleButtonStateText"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Wrap text: Off" />
                    </ContentControl>
                    <local:DemoSampleControl SampleDescription="Use ToggleButton when a command switches a state on or off and should look pressed while active." />


                    <ContentControl x:Name="DemoSampleSlot10DemoContentHost" Visibility="Collapsed">
                        <WrapPanel VerticalAlignment="Center">
                            <fluence:ToggleSplitButton
                                x:Name="ListToggleSplitButton"
                                Margin="{DynamicResource DemoControlGroupItemMargin}"
                                Content="Bulleted list"
                                IsCheckedChanged="ListToggleSplitButton_IsCheckedChanged">
                                <fluence:ToggleSplitButton.Flyout>
                                    <StackPanel MinWidth="180" Margin="{DynamicResource DemoSampleInnerCardPadding}">
                                        <fluence:Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Appearance="Subtle"
                                            Click="ListStyleButton_Click"
                                            Content="Bulleted list" />
                                        <fluence:Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Appearance="Subtle"
                                            Click="ListStyleButton_Click"
                                            Content="Numbered list" />
                                        <fluence:Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Appearance="Subtle"
                                            Click="ListStyleButton_Click"
                                            Content="Checklist" />
                                    </StackPanel>
                                </fluence:ToggleSplitButton.Flyout>
                            </fluence:ToggleSplitButton>
                            <fluence:ToggleSplitButton
                                Margin="{DynamicResource DemoControlGroupItemMargin}"
                                Content="Disabled"
                                IsChecked="True"
                                IsEnabled="False">
                                <fluence:ToggleSplitButton.Flyout>
                                    <TextBlock Margin="{DynamicResource DemoSampleInnerCardPadding}" Text="Unavailable" />
                                </fluence:ToggleSplitButton.Flyout>
                            </fluence:ToggleSplitButton>
                        </WrapPanel>
                    </ContentControl>
                    <ContentControl x:Name="DemoSampleSlot10OutputContentHost" Visibility="Collapsed">
                        <TextBlock
                            x:Name="ToggleSplitButtonStateText"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="List formatting: Off" />
                    </ContentControl>
                    <local:DemoSampleControl SampleDescription="Use ToggleSplitButton when the primary half toggles a state and the flyout chooses which variant of that state to apply." />
                </StackPanel>
            </fluence:SmoothScrollViewer>
        </Grid>
    </Grid>
</Page>
