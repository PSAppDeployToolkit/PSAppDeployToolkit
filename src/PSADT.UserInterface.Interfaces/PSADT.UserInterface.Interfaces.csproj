<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Product>PSAppDeployToolkit User Interface Dialog Library</Product>
    <AssemblyTitle>PSAppDeployToolkit User Interface Dialog Library</AssemblyTitle>
    <AssemblyDescription>This product provides user interface capabilities to PSAppDeployToolkit.</AssemblyDescription>
    <NoWarn>SYSLIB1045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\vendor\Fluence.Wpf\Fluence.Wpf\Fluence.Wpf.csproj" />
    <ProjectReference Include="..\PSADT\PSADT.csproj" />
    <ProjectReference Include="..\PSADT.UserInterface\PSADT.UserInterface.csproj" />
    <ProjectReference Include="..\PSAppDeployToolkit\PSAppDeployToolkit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PSADT.ClientServer.Client" />
    <InternalsVisibleTo Include="PSADT.ClientServer.Client.Compatible" />
    <InternalsVisibleTo Include="PSADT.ClientServer.Client.Launcher" />
    <InternalsVisibleTo Include="PSADT.ClientServer.Client.Launcher.Compatible" />
    <InternalsVisibleTo Include="PSADT.UserInterface.Interfaces.TestHarness" />
  </ItemGroup>

  <!--
    SubType=Form opens these in the Windows Forms designer rather than the code editor. Design-time
    only; it has no effect on the build. The paths carried a stale "Interfaces\" prefix that matched
    nothing, so the whole group was inert - Visual Studio had quietly rewritten the correct list into
    the untracked .csproj.user beside this file, which is why nobody noticed. This is that list.
  -->
  <ItemGroup>
    <Compile Update="Classic\ClassicBase.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Classic\ClassicDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Classic\CloseAppsDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Classic\CustomDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Classic\HelpConsole.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Classic\InputDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Classic\ListSelectionDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Classic\ProgressDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Classic\RestartDialog.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
