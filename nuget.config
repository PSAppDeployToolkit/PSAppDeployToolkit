<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Supply-chain boundary file: pins package restore for this repository to an explicit, closed set of
    feeds, and requires every restored package to carry a signature from a known publisher. Without it,
    restore inherits whatever sources happen to be registered in the user-level and machine-level NuGet
    configuration of the machine doing the build, which differs between developer workstations, build
    agents, and Visual Studio installations.
  -->

  <!--
    <clear /> discards every inherited source before the allowed ones are added, so restore cannot fall
    back to a feed this file does not name. On a stock Visual Studio machine that inherited set already
    includes the local "Microsoft Visual Studio Offline Packages" folder source.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    Inherited configuration can disable a source as well as add one; clearing the list keeps every source
    declared above enabled regardless of what the surrounding machine says.
  -->
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>

  <!--
    Package source mapping binds package ID patterns to specific feeds. Restore will only accept a package
    from the feed its pattern maps to, which is the defence against dependency-confusion attacks: an
    attacker who publishes a package matching one of our IDs to a feed we have not mapped it to cannot get
    it installed. Every package currently resolves from nuget.org, so a single "*" pattern covers the repo.

    When a private feed is added, give it the narrowest patterns that cover its packages and leave "*"
    mapped to nuget.org. Note that once any mapping exists, every package must match a pattern, including
    transitive dependencies.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!--
    Sources consulted for the vulnerability data behind NuGet audit (NU1901 to NU1904). Declaring these
    explicitly keeps auditing working if a private feed is added later: private feeds generally do not
    publish a vulnerability index, and without an audit source that serves one, audit degrades silently.
  -->
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </auditSources>

  <!--
    "require" rejects any package that is unsigned or whose signature does not chain to a signer listed in
    <trustedSigners> below, failing restore with NU3034 rather than installing it. This catches a package
    tampered with in transit or served by a feed impersonating nuget.org. Signature verification is
    enforced on Windows, which is the only platform this repository builds on.
  -->
  <config>
    <add key="signatureValidationMode" value="require" />
  </config>

  <!--
    The repository signing certificates nuget.org uses to counter-sign every package it serves. More than
    one is listed because nuget.org publishes its current and upcoming certificates side by side so that
    rotation does not break consumers mid-flight.

    MAINTENANCE: when nuget.org retires a certificate, restore begins failing with NU3034 for every
    package, on developer machines and CI alike. Regenerate this block rather than editing fingerprints by
    hand, so that they come from the live service index:

        dotnet nuget trust source nuget.org

    Run that from the repository root and point its configfile switch at this file. The switch is spelled
    out rather than shown because an XML comment cannot contain a double hyphen.
  -->
  <trustedSigners>
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
      <certificate fingerprint="0e5f38f57dc1bcc806d8494f4f90fbcedd988b46760709cbeec6f4219aa6157d" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="5a2901d6ada3d18260b9c6dfe2133c95d74b9eef6ae0e5dc334c8454d1477df4" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="1f4b311d9acc115c8dc8018b5a49e00fce6da8e2855f9f014ca6f34570bc482d" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
    </repository>
  </trustedSigners>

</configuration>
