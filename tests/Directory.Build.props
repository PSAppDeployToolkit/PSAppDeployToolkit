<Project>
  <!--
    MSBuild stops walking upward the moment it finds a Directory.Build.props, so this file would
    otherwise shadow the one at the repository root. Import that one explicitly to keep the shared
    analyzer set, BannedSymbols.txt, COPYING.Lesser, lock file settings and assembly metadata in
    play. Everything it declares uses $(MSBuildThisFileDirectory), which is evaluated in the file
    that declares it, so those paths still resolve against the repository root and not against this
    directory.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove($(MSBuildThisFile), $(MSBuildThisFileDirectory)..))" />

  <!-- Common properties for all PSADT test projects -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>false</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    CA1707 fires on the underscores that separate scenario from expectation in test method names.
    Projects append their own suppressions by prefixing $(NoWarn), the same way
    Directory.Build.targets does.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <!--
    xunit.v3 with the Visual Studio runner, driven by Microsoft.NET.Test.Sdk. xunit.v3 needs
    OutputType Exe, set above. Versions come from Directory.Packages.props at the repository root.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Run under Microsoft.Testing.Platform rather than xunit's own console runner, which is what makes code
    coverage available: the collector is an MTP extension, and an assembly built for xunit's runner never
    loads it. It is also what lets "dotnet test" discover these projects at all; against xunit's runner it
    reports zero tests and exits 5.

    This changes the command line every test executable accepts. xunit's own single-dash arguments for
    selecting tests and choosing a reporter are replaced by MTP's own filtering options, so anything
    scripted against the old ones needs updating alongside.
  -->
  <PropertyGroup>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

</Project>
