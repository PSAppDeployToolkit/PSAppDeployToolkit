<Project>
  <!--
    MSBuild stops walking upward the moment it finds a Directory.Build.props, so this file would
    otherwise shadow the one at the repository root. Import that one explicitly to keep the shared
    analyzer set, BannedSymbols.txt, COPYING.Lesser, lock file settings and assembly metadata in
    play. Everything it declares uses $(MSBuildThisFileDirectory), which is evaluated in the file
    that declares it, so those paths still resolve against the repository root and not against this
    directory.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove($(MSBuildThisFile), $(MSBuildThisFileDirectory)..))" />

  <!-- Common properties for everything under tests, harness and support library alike -->
  <PropertyGroup>
    <ImplicitUsings>false</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Not everything under this directory is a test project. A support library shared between test
    projects - PSAppDeployToolkit.Tests.Fixture, which stands up the PowerShell runspace the
    PSAppDeployToolkit tests need - belongs here alongside them but must not be handed an entry
    point, a test runner or IsTestProject, or the test platform tries to run it as a suite of its
    own and finds nothing.

    The split is on the project name rather than a property the project sets, because this file is
    imported before the project body and cannot read anything the project declares. Every test
    project here is named for the assembly it covers with a .Tests suffix, so that suffix is the
    condition; a support library is anything else.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    CA1707 fires on the underscores that separate scenario from expectation in test method names.
    Projects append their own suppressions by prefixing $(NoWarn), the same way
    Directory.Build.targets does.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <!--
    xunit.v3 with the Visual Studio runner, driven by Microsoft.NET.Test.Sdk. xunit.v3 needs
    OutputType Exe, set above. Versions come from Directory.Packages.props at the repository root.
  -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
