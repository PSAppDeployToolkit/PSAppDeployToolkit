<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Fluence.Wpf.Controls">

    <!--
        Fluent Design Menu (horizontal menu bar) style.
        Authority: WinUI 3 MenuBar_themeresources.xaml (brush keys, typography).
        The bar itself is transparent; it exposes top-level MenuItem entries that share
        the MenuItem style from ContextMenu.xaml (Fluent flyout popup on click).
    -->
    <Style TargetType="{x:Type controls:Menu}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource FluentFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <!--
            MenuBarHeight = 40 (WinUI 3 MenuBar.xaml DefaultMenuBarStyle sets MinHeight, not
            Height, to this resource). Fluence's Menu is the WPF counterpart of WinUI's MenuBar,
            so the bar is floored at that height rather than pinned to it, so a consumer that
            puts taller content in a top-level item is not clipped.
        -->
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <!--
                    Explicit template required: without it WPF falls back to the Aero-theme
                    system template for Menu which clamps the bar to MenuBarHeight (~19 px)
                    and prevents Fluence MenuItem items from rendering at their natural height.
                    Authority: .NET 10 WPF Menu.xaml generic template (ItemsPresenter pattern).
                -->
                <ControlTemplate TargetType="{x:Type controls:Menu}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        UseLayoutRounding="{TemplateBinding UseLayoutRounding}">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

</ResourceDictionary>
