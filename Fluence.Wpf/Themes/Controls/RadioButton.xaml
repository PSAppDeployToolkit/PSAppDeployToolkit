<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Fluence.Wpf.Controls">

    <Style TargetType="{x:Type controls:RadioButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="FontFamily" Value="{DynamicResource FluentFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RadioButton}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Radio indicator  -->
                        <Grid
                            x:Name="IndicatorHost"
                            Grid.Row="0"
                            Grid.Column="0"
                            Width="20"
                            Height="20"
                            Margin="0,0,0,0"
                            VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>

                            <!--
                                Opaque sub-layer under the checked-state ellipses so the accent
                                hover/press fills (AccentFillColorSecondary 0.9 / Tertiary 0.8 /
                                Disabled) composite against a surface-matched solid rather than
                                whatever translucent form / card / Mica sits beneath the radio
                                indicator. Visible only when IsChecked=True.
                            -->
                            <Ellipse
                                x:Name="IndicatorAccentBackdrop"
                                Width="20"
                                Height="20"
                                Fill="{DynamicResource AccentFillBackdropBrush}"
                                Opacity="0" />

                            <!--  Unchecked: normal  -->
                            <Ellipse
                                x:Name="OuterEllipse"
                                Width="20"
                                Height="20"
                                Fill="{DynamicResource ControlAltFillColorSecondaryBrush}"
                                Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                StrokeThickness="1" />

                            <!--  Unchecked: hover overlay  -->
                            <Ellipse
                                x:Name="OuterEllipseHover"
                                Width="20"
                                Height="20"
                                Fill="{DynamicResource ControlAltFillColorTertiaryBrush}"
                                Opacity="0"
                                Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                StrokeThickness="1" />

                            <!--  Unchecked: pressed overlay  -->
                            <Ellipse
                                x:Name="OuterEllipsePressed"
                                Width="20"
                                Height="20"
                                Fill="{DynamicResource ControlAltFillColorQuarternaryBrush}"
                                Opacity="0"
                                Stroke="{DynamicResource ControlStrongStrokeColorDisabledBrush}"
                                StrokeThickness="1" />

                            <!--  Checked: accent fill  -->
                            <Ellipse
                                x:Name="CheckedEllipse"
                                Width="20"
                                Height="20"
                                Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                Opacity="0" />

                            <!--  Checked: hover accent  -->
                            <Ellipse
                                x:Name="CheckedEllipseHover"
                                Width="20"
                                Height="20"
                                Fill="{DynamicResource AccentFillColorSecondaryBrush}"
                                Opacity="0" />

                            <!--  Checked: pressed accent  -->
                            <Ellipse
                                x:Name="CheckedEllipsePressed"
                                Width="20"
                                Height="20"
                                Fill="{DynamicResource AccentFillColorTertiaryBrush}"
                                Opacity="0" />

                            <!--
                                Inner dot (color adapts to accent luminance via TextOnAccent).
                                WinUI parity: RadioButtonCheckGlyphStroke family (RadioButton_themeresources.xaml:38-44) -
                                CircleElevationBorderBrush at rest, AccentControlElevationBorderBrush while checked,
                                ControlElevationBorderBrush while checked and disabled.
                            -->
                            <Ellipse
                                x:Name="InnerDot"
                                Width="0"
                                Height="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                Stroke="{DynamicResource CircleElevationBorderBrush}"
                                StrokeThickness="1" />
                        </Grid>

                        <!--  Content  -->
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            RecognizesAccessKey="True"
                            TextElement.FontFamily="{TemplateBinding FontFamily}"
                            TextElement.FontSize="{TemplateBinding FontSize}"
                            TextElement.Foreground="{TemplateBinding Foreground}" />

                        <!--  Description text  -->
                        <TextBlock
                            x:Name="DescriptionText"
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="28,2,0,0"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{TemplateBinding Description}"
                            TextWrapping="Wrap"
                            Visibility="Visible" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!--  Collapse description when null or empty  -->
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!--  Unchecked + Hover  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="OuterEllipseHover" Property="Opacity" Value="1" />
                        </MultiTrigger>

                        <!--  Unchecked + Pressed  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="OuterEllipsePressed" Property="Opacity" Value="1" />
                            <Setter TargetName="IndicatorHost" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>

                        <!--
                            Checked. The anonymous storyboard below grows the dot, and the named
                            state storyboards (hover, pressed, disabled) animate the same property
                            afterwards. WPF layers a later trigger's storyboard over an earlier
                            trigger's rather than replacing it, even under SnapshotAndReplace, so
                            each RemoveStoryboard uncovers this grow again rather than dropping the
                            dot to the template base of 0. Read on its own the handoff looks like it
                            loses the checked size, and two reviewers have now reported it as a
                            defect; RadioButton_CheckedDot_KeepsItsCheckedSizeWhenAStateStoryboardIsReleasedAsync
                            pins the real behaviour.
                        -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="OuterEllipse" Property="Opacity" Value="0" />
                            <Setter TargetName="OuterEllipseHover" Property="Opacity" Value="0" />
                            <Setter TargetName="OuterEllipsePressed" Property="Opacity" Value="0" />
                            <Setter TargetName="CheckedEllipse" Property="Opacity" Value="1" />
                            <Setter TargetName="IndicatorAccentBackdrop" Property="Opacity" Value="1" />
                            <Setter TargetName="InnerDot" Property="Stroke" Value="{DynamicResource AccentControlElevationBorderBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!--  ControlFastAnimationDuration (167 ms) inner-dot grow  -->
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="InnerDot" Storyboard.TargetProperty="Width">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.167"
                                                Value="8" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="InnerDot" Storyboard.TargetProperty="Height">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.167"
                                                Value="8" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="InnerDot" Storyboard.TargetProperty="Width">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.100"
                                                Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="InnerDot" Storyboard.TargetProperty="Height">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.100"
                                                Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!--
                            Checked + Hover. WinUI grows the check glyph while the pointer is over it
                            (RadioButton_themeresources.xaml:255,258), from its resting 12 to 14 over
                            ControlNormalAnimationDuration on the fast out slow in spline. Fluence rests
                            the dot at 8 rather than 12, so the WinUI ratios are applied to that base:
                            14/12 of 8 is 9.33, and 10/12 of 8 is 6.67 for the pressed state below.
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsPressed" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckedEllipse" Property="Opacity" Value="0" />
                            <Setter TargetName="CheckedEllipseHover" Property="Opacity" Value="1" />
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="RadioDotHoverStoryboard">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="InnerDot" Storyboard.TargetProperty="Width">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.25"
                                                Value="9.33" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="InnerDot" Storyboard.TargetProperty="Height">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.25"
                                                Value="9.33" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RadioDotHoverStoryboard" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <!--
                            Checked + Pressed. The dot shrank here by a stamped setter, where WinUI
                            animates its CheckGlyph (RadioButton_themeresources.xaml:292,295) over
                            ControlNormalAnimationDuration. Releasing over the control re-enters the
                            hover trigger above, which grows the dot back to its hover size.
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckedEllipse" Property="Opacity" Value="0" />
                            <Setter TargetName="CheckedEllipseHover" Property="Opacity" Value="0" />
                            <Setter TargetName="CheckedEllipsePressed" Property="Opacity" Value="1" />
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="RadioDotPressedStoryboard">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="InnerDot" Storyboard.TargetProperty="Width">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.25"
                                                Value="6.67" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="InnerDot" Storyboard.TargetProperty="Height">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.25"
                                                Value="6.67" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RadioDotPressedStoryboard" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <!--
                            Disabled. WinUI parity: RadioButtonCheckGlyphFillDisabled (RadioButton_themeresources.xaml:37)
                            is the same TextOnAccentFillColorPrimary used in every other state, not TextFillColorDisabled;
                            RadioButtonCheckGlyphStrokeCheckedDisabled is ControlElevationBorderBrush. The Fluence-only
                            opaque IndicatorAccentBackdrop plate must also drop out while disabled.
                        -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="OuterEllipse" Property="Fill" Value="{DynamicResource ControlAltFillColorDisabledBrush}" />
                            <Setter TargetName="OuterEllipseHover" Property="Fill" Value="{DynamicResource ControlAltFillColorDisabledBrush}" />
                            <Setter TargetName="OuterEllipsePressed" Property="Fill" Value="{DynamicResource ControlAltFillColorDisabledBrush}" />
                            <Setter TargetName="CheckedEllipse" Property="Fill" Value="{DynamicResource AccentFillColorDisabledBrush}" />
                            <Setter TargetName="CheckedEllipseHover" Property="Fill" Value="{DynamicResource AccentFillColorDisabledBrush}" />
                            <Setter TargetName="CheckedEllipsePressed" Property="Fill" Value="{DynamicResource AccentFillColorDisabledBrush}" />
                            <Setter TargetName="InnerDot" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            <Setter TargetName="InnerDot" Property="Stroke" Value="{DynamicResource ControlElevationBorderBrush}" />
                            <Setter TargetName="IndicatorAccentBackdrop" Property="Opacity" Value="0" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter TargetName="DescriptionText" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter TargetName="OuterEllipse" Property="Stroke" Value="{DynamicResource ControlStrongStrokeColorDisabledBrush}" />
                            <Setter TargetName="OuterEllipseHover" Property="Stroke" Value="{DynamicResource ControlStrongStrokeColorDisabledBrush}" />
                            <Setter TargetName="OuterEllipsePressed" Property="Stroke" Value="{DynamicResource ControlStrongStrokeColorDisabledBrush}" />
                        </Trigger>

                        <!--
                            Disabled + Checked. WinUI grows the glyph to 14 over
                            ControlFastAnimationDuration while disabled
                            (RadioButton_themeresources.xaml:338,341), the same size it takes on hover,
                            because the disabled accent plate behind it carries far less contrast. The
                            checked condition is Fluence specific: the dot is hidden by a zero size
                            rather than by opacity, so an unguarded disabled state would reveal it on an
                            unchecked button.
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="RadioDotDisabledStoryboard">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="InnerDot" Storyboard.TargetProperty="Width">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.167"
                                                Value="9.33" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="InnerDot" Storyboard.TargetProperty="Height">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.167"
                                                Value="9.33" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RadioDotDisabledStoryboard" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
