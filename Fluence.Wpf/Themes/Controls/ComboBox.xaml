<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Fluence.Wpf.Controls">

    <!--  The item corner radius is the published ComboBoxItemCornerRadius (WinUI's 3, deliberately not ControlCornerRadius 4), defined beside the other corner radii in SpecialBrushes.AddSharedTokens so an application overriding corner radii reaches it through a supported key.  -->

    <Style x:Key="ComboBoxToggleStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="ComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{DynamicResource FluentFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <!--  WinUI ComboBoxItemThemePadding = 11,5,11,7 (ComboBox_themeresources_perf2026.xaml line 335)  -->
        <Setter Property="Padding" Value="11,5,11,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <!--  WinUI LayoutRoot Margin = 5,2,5,2 (ComboBox_themeresources_perf2026.xaml line 568)  -->
                    <Border
                        x:Name="OuterBorder"
                        Margin="5,2,5,2"
                        Background="Transparent"
                        CornerRadius="{DynamicResource ComboBoxItemCornerRadius}">
                        <Grid>
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                TextElement.FontFamily="{TemplateBinding FontFamily}"
                                TextElement.FontSize="{TemplateBinding FontSize}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                            <!--  WinUI ComboBoxItemPillWidth 3, ComboBoxItemPillHeight 16, ComboBoxItemPillCornerRadius 1.5, pill Margin 1,0,0,0 (ComboBox_themeresources_perf2026.xaml lines 325, 324, 346 and 526)  -->
                            <Border
                                x:Name="SelectionIndicator"
                                Width="3"
                                Height="16"
                                Margin="1,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{DynamicResource NavigationViewSelectionIndicatorForeground}"
                                CornerRadius="1.5"
                                Opacity="0"
                                RenderTransformOrigin="0.5,0.5">
                                <!--
                                    The pill takes the shared indicator brush rather than the accent fill
                                    directly. WinUI keys it separately (ComboBoxItemPillFillBrush, the accent
                                    fill in light and dark at ComboBox_themeresources.xaml:106,316) but swaps
                                    it in high contrast (:211), and the shared key is where Fluence keeps that
                                    swap for every other selection indicator in the library.
                                -->
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="SelectionIndicatorScale" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter TargetName="SelectionIndicator" Property="Opacity" Value="1" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsHighlighted" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsEnabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <!--  The pill keeps full strength while the item is selected and disabled, as WinUI's SelectedDisabled state does (ComboBox_themeresources.xaml:689-692); only the row fill and the text take disabled tokens.  -->
                            <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>

                        <!--
                            Pressing a selected row squashes its pill to ComboBoxItemPillMinScale 0.625 over
                            ComboBoxItemScaleAnimationDuration 167 ms on the fast out slow in spline, which is
                            WinUI's SelectedPressed state (ComboBox_themeresources.xaml:726-727, constants
                            :326 and :330). WPF's ComboBoxItem carries no IsPressed property, so the press is
                            read from the mouse button events the item already receives.
                        -->
                        <EventTrigger RoutedEvent="UIElement.PreviewMouseLeftButtonDown">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetName="SelectionIndicatorScale"
                                        Storyboard.TargetProperty="ScaleY"
                                        To="0.625"
                                        Duration="0:0:0.167">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="UIElement.PreviewMouseLeftButtonUp">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetName="SelectionIndicatorScale"
                                        Storyboard.TargetProperty="ScaleY"
                                        To="1"
                                        Duration="0:0:0.167">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="UIElement.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetName="SelectionIndicatorScale"
                                        Storyboard.TargetProperty="ScaleY"
                                        To="1"
                                        Duration="0:0:0.167">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ComboBoxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>
                        <Border
                            Margin="-3"
                            BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}"
                            BorderThickness="2"
                            CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <!--  The inner focus ring sits 1 dip inside the outer one, so its radius is the control radius less that inset rather than a token of its own.  -->
                        <Border
                            Margin="-2"
                            BorderBrush="{DynamicResource FocusStrokeColorInnerBrush}"
                            BorderThickness="1"
                            CornerRadius="3" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:ComboBox}">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextControlElevationBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="DropdownCornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ComboBoxFocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource FluentFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemStyle}" />
        <!--  WinUI ComboBox MaxDropDownHeight = 504 (ComboBox_themeresources_perf2026.xaml line 361)  -->
        <Setter Property="MaxDropDownHeight" Value="504" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,5,6,6" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ComboBox}">
                    <Grid x:Name="TemplateRoot">
                        <Grid>
                            <Border
                                x:Name="MainBorder"
                                MinHeight="{TemplateBinding MinHeight}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <Grid>
                                    <Grid
                                        x:Name="ContentLayer"
                                        Margin="{TemplateBinding Padding}"
                                        IsHitTestVisible="False">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter
                                            x:Name="LeftIcon"
                                            Grid.Column="0"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Content="{TemplateBinding Icon}"
                                            TextElement.Foreground="{TemplateBinding Foreground}"
                                            Visibility="Visible">
                                            <ContentPresenter.Resources>
                                                <!--  Icon follows the selection text (SplitButton precedent): the scoped implicit style outranks the FontIcon theme-style Foreground; a consumer's local Foreground still wins.  -->
                                                <Style TargetType="{x:Type controls:FontIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:ComboBox}}}" />
                                                </Style>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <ContentPresenter
                                                x:Name="contentPresenter"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Content="{TemplateBinding SelectionBoxItem}"
                                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                IsHitTestVisible="False"
                                                TextElement.FontFamily="{TemplateBinding FontFamily}"
                                                TextElement.FontSize="{TemplateBinding FontSize}"
                                                TextElement.Foreground="{TemplateBinding Foreground}" />
                                            <TextBlock
                                                x:Name="PlaceholderTextBlock"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                FontFamily="{TemplateBinding FontFamily}"
                                                FontSize="{TemplateBinding FontSize}"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{TemplateBinding PlaceholderText}"
                                                Visibility="Collapsed" />
                                        </Grid>
                                        <controls:FontIcon
                                            x:Name="ChevronGlyph"
                                            Grid.Column="2"
                                            Margin="8,0,4,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE70D;"
                                            IconFontSize="12" />
                                    </Grid>
                                    <ToggleButton
                                        x:Name="ToggleButton"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                        Style="{StaticResource ComboBoxToggleStyle}" />
                                </Grid>
                            </Border>
                            <Border
                                x:Name="FocusAccentLine"
                                Height="2"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="0,0,4,4"
                                Opacity="0"
                                Visibility="Collapsed" />
                        </Grid>
                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            HorizontalOffset="-16"
                            VerticalOffset="-16"
                            Focusable="False"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=MainBorder}"
                            PopupAnimation="None">
                            <!--
                                PART_DropdownBorder paints AcrylicBackgroundFillColorDefaultBrush
                                (opaque), the same acrylic-fallback token FlyoutPresenter /
                                ContextMenu / AutoSuggestBox / DatePicker / TimePicker /
                                CommandBarFlyout / SplitButton / ToggleSplitButton / DropDownButton
                                use for their popup backplates, matching the WinUI acrylic
                                FallbackColor, so it takes the same
                                RenderOptions.ClearTypeHint="Enabled" treatment as those opaque
                                plates. The AcrylicNoiseBrush overlay is declared before the
                                ScrollViewer in the Grid, so it paints behind the item text rather
                                than over it and does not reintroduce a translucent layer between the
                                glyphs and the eye.
                            -->
                            <!--
                                The reveal fades this root, not the dropdown surface alone, so the
                                opaque ShadowCaster behind the surface fades with it. Fading only the
                                surface left the caster painting a blank dark plate at full strength
                                on the first frame of every open, which read as a black flash before
                                the dropdown resolved. The root starts hidden: a popup HWND can be
                                created and shown before ComboBox.OnDropDownOpened runs (WPF does not
                                order the IsDropDownOpen invalidation against the Popup.IsOpen
                                template binding), so an unhidden root can composite one frame at
                                rest before the reveal seeds its start pose.
                            -->
                            <Grid x:Name="PART_DropdownRoot" Margin="16" Opacity="0">
                                <!--
                                    Elevation is cast by an empty sibling behind the dropdown, painted
                                    with the same opaque AcrylicBackgroundFillColorDefaultBrush as the
                                    plate below it. This Grid's 16px margin is the popup's shadow
                                    gutter: WPF sizes a popup HWND to exactly its child's layout size,
                                    so without it the effect is clipped to the plate and only the
                                    corner notches survive. PART_Popup's HorizontalOffset and
                                    VerticalOffset of -16 pull it back so the plate keeps its position.
                                -->
                                <Border
                                    x:Name="ShadowCaster"
                                    MinWidth="{Binding ActualWidth, ElementName=MainBorder}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,4,0,0"
                                    Background="{DynamicResource AcrylicBackgroundFillColorDefaultBrush}"
                                    CornerRadius="{TemplateBinding DropdownCornerRadius}"
                                    Effect="{DynamicResource FlyoutShadowEffect}"
                                    RenderTransform="{Binding RenderTransform, ElementName=PART_DropdownBorder}"
                                    RenderTransformOrigin="0.5,0" />
                                <Border
                                    x:Name="PART_DropdownBorder"
                                    MinWidth="{Binding ActualWidth, ElementName=MainBorder}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,4,0,0"
                                    Background="{DynamicResource AcrylicBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{TemplateBinding DropdownCornerRadius}"
                                    RenderOptions.ClearTypeHint="Enabled"
                                    RenderTransformOrigin="0.5,0">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="DropdownTranslate" />
                                    </Border.RenderTransform>
                                    <Grid>
                                        <!--  The noise overlay fills the rounded popup shape. Its CornerRadius  -->
                                        <!--  MUST track the outer PART_DropdownBorder.CornerRadius so that when  -->
                                        <!--  the popup opens upward (IsDropDownOpenedUpward=True) the outer goes  -->
                                        <!--  flat at the bottom and the noise does the same - otherwise the noise  -->
                                        <!--  paints rounded bottom corners that no longer match the outer flat  -->
                                        <!--  edge, which reads as "bottom corners not properly rounded".  -->
                                        <Border
                                            x:Name="NoiseOverlay"
                                            Background="{DynamicResource AcrylicNoiseBrush}"
                                            CornerRadius="{TemplateBinding DropdownCornerRadius}"
                                            Opacity="0.04" />
                                        <!--  WinUI ComboBoxDropdownBorderPadding is 0 and the items presenter carries ComboBoxDropdownContentMargin = 0,4; the horizontal inset comes from each item's own 5,2,5,2 margin (ComboBox_themeresources_perf2026.xaml lines 107, 339 and 546).  -->
                                        <ScrollViewer
                                            CanContentScroll="True"
                                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                            Style="{DynamicResource ScrollViewerStyle}"
                                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                            <ItemsPresenter Margin="0,4" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Popup>
                        <!--
                            WI-3 C18: FocusedStates + EditableFocusedStates VSM groups.
                            Authority: WinUI 3 ComboBox_DynamicResources.xaml.
                            Fluence intentionally suppresses the ComboBox focus underline; selected
                            dropdown items retain their left selection indicator.
                            EditableFocusedStates mirrors FocusedStates for future IsEditable support.
                        -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="FocusedStates">
                                <VisualState x:Name="Focused" />
                                <VisualState x:Name="Unfocused" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="EditableFocusedStates">
                                <VisualState x:Name="EditableFocused" />
                                <VisualState x:Name="EditableUnfocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--
                            The dropdown open reveal (8px slide from the control edge + fade,
                            167ms ControlFastAnimationDuration on ControlFastOutSlowInKeySpline)
                            lives in ComboBox.BeginDropdownReveal, following the FlyoutPresenter
                            code-reveal precedent: a XAML trigger cannot consult the
                            reduced-motion helper, but code can, so the reveal is skipped when
                            the OS "Show animations" setting is off. The code targets
                            PART_DropdownBorder and its DropdownTranslate render transform.
                        -->
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="LeftIcon" Property="Margin" Value="0" />
                            <Setter TargetName="LeftIcon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="SelectedItem" Value="{x:Null}">
                            <Setter TargetName="contentPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlaceholderTextBlock" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            <!--  Focus underline intentionally suppressed; dropdown items own selection visuals.  -->
                        </Trigger>
                        <Trigger Property="IsDropDownOpenedUpward" Value="True">
                            <Setter TargetName="PART_DropdownBorder" Property="CornerRadius" Value="8,8,0,0" />
                            <!--  Track the outer border's runtime shape - see NoiseOverlay comment above.  -->
                            <Setter TargetName="NoiseOverlay" Property="CornerRadius" Value="8,8,0,0" />
                            <Setter TargetName="PART_DropdownBorder" Property="Margin" Value="0,0,0,4" />
                            <Setter TargetName="PART_DropdownBorder" Property="RenderTransformOrigin" Value="0.5,1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}" />
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <Setter TargetName="MainBorder" Property="BorderThickness" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter TargetName="ChevronGlyph" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>
</ResourceDictionary>
