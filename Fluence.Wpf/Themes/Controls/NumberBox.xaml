<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Fluence.Wpf.Controls"
    xmlns:fluence="clr-namespace:Fluence.Wpf">

    <!--
        Matches the WinUI 3 NumberBoxSpinButtonStyle (NumberBox_perf2026.xaml, BasedOn
        DefaultRepeatButtonStyle): the style remaps RepeatButtonBackground /
        RepeatButtonBorderBrush (and their PointerOver / Pressed / Disabled variants) to the
        TextControlButton* tokens defined in TextBox_themeresources.xaml, where the border is
        ControlFillColorTransparent in every state and the rest fill is transparent too, with
        hover/pressed filled by SubtleFillColorSecondary/SubtleFillColorTertiary.
        NumberBoxSpinButtonBorderThickness (NumberBox_themeresources.xaml) stays "0,1,1,1".
    -->
    <Style x:Key="NumberBoxSpinButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlFillColorTransparentBrush}" />
        <Setter Property="BorderThickness" Value="0,1,1,1" />
        <!--  Fire Click immediately on MouseDown so a quick press-release registers  -->
        <!--  (default Release mode waits for the internal timer's first tick).  -->
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border
                        x:Name="SpinBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SpinBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="SpinBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            <Setter TargetName="SpinBorder" Property="BorderBrush" Value="{DynamicResource ControlFillColorTransparentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="SpinBorder" Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
                            <Setter TargetName="SpinBorder" Property="BorderBrush" Value="{DynamicResource ControlFillColorTransparentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style TargetType="{x:Type controls:NumberBox}">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextControlElevationBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{DynamicResource FluentFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <!--
            IsTabStop=False: the outer NumberBox shell must not be a tab stop.
            Focus is hosted by PART_TextBox (inner element). Without this,
            Shift+Tab from PART_TextBox lands on the NumberBox shell which
            immediately redirects focus back to PART_TextBox - an infinite loop
            that prevents Shift+Tab from escaping to the previous outer control.
        -->
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="Padding" Value="10,5,6,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NumberBox}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Header  -->
                        <ContentPresenter
                            x:Name="HeaderPresenter"
                            Grid.Row="0"
                            Margin="0,0,0,8"
                            Content="{TemplateBinding Header}"
                            TextBlock.FontFamily="{TemplateBinding FontFamily}"
                            TextBlock.FontSize="{TemplateBinding FontSize}"
                            TextBlock.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <Border
                            x:Name="MainBorder"
                            Grid.Row="1"
                            MinHeight="{TemplateBinding MinHeight}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="SpinColumn" Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox
                                        x:Name="PART_TextBox"
                                        Grid.Column="0"
                                        Padding="{TemplateBinding Padding}"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                        FontFamily="{TemplateBinding FontFamily}"
                                        FontSize="{TemplateBinding FontSize}"
                                        Foreground="{TemplateBinding Foreground}"
                                        SelectionBrush="{DynamicResource AccentFillColorSelectedTextBackgroundBrush}"
                                        Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <!--
                                        The placeholder sits over PART_TextBox on the same Padding, so
                                        it lands where the number would. It shows for an empty field,
                                        which is the state a cleared Value (NaN) renders as.
                                    -->
                                    <TextBlock
                                        x:Name="PlaceholderTextBlock"
                                        Grid.Column="0"
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"
                                        FontFamily="{TemplateBinding FontFamily}"
                                        FontSize="{TemplateBinding FontSize}"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        IsHitTestVisible="False"
                                        Text="{TemplateBinding PlaceholderText}"
                                        Visibility="Collapsed" />

                                    <!--
                                        WinUI insets each spin button rather than the panel that holds
                                        them: NumberBox.xaml gives UpSpinButton Margin="4" and
                                        DownSpinButton Margin="0,4,4,4", so the pair sits 4px inside
                                        the field on every edge and the two buttons touch.
                                    -->
                                    <StackPanel
                                        x:Name="SpinPanel"
                                        Grid.Column="1"
                                        VerticalAlignment="Stretch"
                                        Orientation="Horizontal">
                                        <RepeatButton
                                            x:Name="PART_UpButton"
                                            Margin="4"
                                            AutomationProperties.Name="Increase"
                                            Style="{StaticResource NumberBoxSpinButton}"
                                            ToolTip="Increase">
                                            <Path
                                                Width="8"
                                                Height="5"
                                                Data="M 0,4 L 4,0 L 8,4"
                                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RepeatButton}}}"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeThickness="1.5" />
                                        </RepeatButton>
                                        <RepeatButton
                                            x:Name="PART_DownButton"
                                            Margin="0,4,4,4"
                                            AutomationProperties.Name="Decrease"
                                            Style="{StaticResource NumberBoxSpinButton}"
                                            ToolTip="Decrease">
                                            <Path
                                                Width="8"
                                                Height="5"
                                                Data="M 0,0 L 4,4 L 8,0"
                                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RepeatButton}}}"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeThickness="1.5" />
                                        </RepeatButton>
                                    </StackPanel>
                                </Grid>

                                <!--  Bottom accent line (focus indicator)  -->
                                <Border
                                    x:Name="FocusLine"
                                    Grid.Row="1"
                                    Height="1.5"
                                    HorizontalAlignment="Stretch"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    CornerRadius="0,0,4,4"
                                    Opacity="0" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PlaceholderTextBlock" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource ControlFillColorInputActiveBrush}" />
                            <!--
                                BorderBrush intentionally stays TextControlElevationBorderBrush on focus
                                (matching TextBox.xaml and PasswordBox.xaml): the bottom accent FocusLine
                                already signals focus, and swapping to the flat ControlStrokeColorDefaultBrush
                                here replaced that gradient underline instead of layering on top of it.
                            -->
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusLine" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.167"
                                                Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusLine" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.167"
                                                Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocusWithin" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource ControlFillColorInputActiveBrush}" />
                        </MultiTrigger>
                        <Trigger Property="SpinButtonPlacementMode" Value="{x:Static fluence:NumberBoxSpinButtonPlacementMode.Hidden}">
                            <Setter TargetName="SpinPanel" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="SpinButtonPlacementMode" Value="{x:Static fluence:NumberBoxSpinButtonPlacementMode.Compact}">
                            <Setter TargetName="SpinPanel" Property="IsHitTestVisible" Value="False" />
                            <Setter TargetName="SpinPanel" Property="Opacity" Value="0" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="SpinButtonPlacementMode" Value="{x:Static fluence:NumberBoxSpinButtonPlacementMode.Compact}" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SpinPanel" Property="IsHitTestVisible" Value="True" />
                            <Setter TargetName="SpinPanel" Property="Opacity" Value="1" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="SpinButtonPlacementMode" Value="{x:Static fluence:NumberBoxSpinButtonPlacementMode.Compact}" />
                                <Condition Property="IsKeyboardFocusWithin" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SpinPanel" Property="IsHitTestVisible" Value="True" />
                            <Setter TargetName="SpinPanel" Property="Opacity" Value="1" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}" />
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <Setter TargetName="PlaceholderTextBlock" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
