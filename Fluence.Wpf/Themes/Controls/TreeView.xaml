<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Fluence.Wpf.Controls"
    xmlns:fluence="clr-namespace:Fluence.Wpf">

    <!--
        Fluent TreeViewItem style.
        Authority: WinUI 3 TreeView_themeresources.xaml + TreeViewItem.xaml.
        Brush states: SubtleFillColorSecondaryBrush (hover/selected), SubtleFillColorTertiaryBrush (selected+hover).
        Chevron: Segoe Fluent Icons U+E76C (ChevronRight), animated 0°→90° on expand via ControlFastOutSlowIn easing.
        MinHeight=32 per WinUI 3 TreeViewItemMinHeight=28 + WPF padding adjustment.
    -->
    <Style TargetType="{x:Type controls:TreeViewItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultCollectionFocusVisualStyle}" />
        <Setter Property="FontFamily" Value="{DynamicResource FluentFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="4,0,8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TreeViewItem}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Item header row - full-width hover/selection highlight  -->
                        <Border
                            x:Name="ItemBorder"
                            Grid.Row="0"
                            MinHeight="{TemplateBinding MinHeight}"
                            Background="Transparent"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Expand/collapse toggle; Visibility driven by HasItems trigger  -->
                                    <ToggleButton
                                        x:Name="Expander"
                                        Grid.Column="0"
                                        Width="28"
                                        ClickMode="Press"
                                        Focusable="False"
                                        IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                        Visibility="Collapsed">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Background="Transparent">
                                                    <!--  WI-5B.2: ChevronRight glyph, rotates 0°→90° on expand.  -->
                                                    <TextBlock
                                                        x:Name="ChevronGlyph"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        RenderTransformOrigin="0.5,0.5"
                                                        Text="&#xE76C;">
                                                        <TextBlock.RenderTransform>
                                                            <RotateTransform x:Name="ChevronRotate" Angle="0" />
                                                        </TextBlock.RenderTransform>
                                                    </TextBlock>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <!--  Expand: animate chevron 0°→90° with ControlFastOutSlowIn easing (167ms).  -->
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ChevronRotate" Storyboard.TargetProperty="Angle">
                                                                        <SplineDoubleKeyFrame
                                                                            KeySpline="0,0,0,1"
                                                                            KeyTime="0:0:0.167"
                                                                            Value="90" />
                                                                    </DoubleAnimationUsingKeyFrames>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ChevronRotate" Storyboard.TargetProperty="Angle">
                                                                        <SplineDoubleKeyFrame
                                                                            KeySpline="0,0,0,1"
                                                                            KeyTime="0:0:0.167"
                                                                            Value="0" />
                                                                    </DoubleAnimationUsingKeyFrames>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <!--  A content-less checkbox in this Auto-width column must not inherit the WinUI DefaultCheckBoxStyle MinWidth of 120 (CheckBox.xaml), or every row grows a wide dead-click gap before the header text.  -->
                                    <controls:CheckBox
                                        x:Name="SelectionCheckBox"
                                        Grid.Column="1"
                                        Margin="0,0,8,0"
                                        MinWidth="0"
                                        VerticalAlignment="Center"
                                        Focusable="False"
                                        IsChecked="{Binding IsSelectionChecked, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                        IsThreeState="True"
                                        Visibility="Collapsed" />

                                    <!--  PART_Header: item label / content  -->
                                    <ContentPresenter
                                        x:Name="PART_Header"
                                        Grid.Column="2"
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        ContentSource="Header"
                                        TextElement.FontFamily="{TemplateBinding FontFamily}"
                                        TextElement.FontSize="{TemplateBinding FontSize}"
                                        TextElement.Foreground="{TemplateBinding Foreground}" />
                                </Grid>
                                <!--
                                    WinUI accent selection pill (TreeViewItem.xaml:130 upstream): 3x16,
                                    RadiusX/Y 2, left-aligned with no inset margin, opacity toggled by
                                    IsSelected. This geometry (radius 2, no margin) does not match
                                    ListView.xaml / ListBox.xaml's SelectionIndicator, which instead
                                    follows the WinUI TableView row indicator (controls/dev/TableView/
                                    TableView.xaml): CornerRadius 1.5 with a 2,0,0,0 inset from the left
                                    edge. TreeView keeps its own TreeViewItem.xaml-sourced radius rather
                                    than the TableView one. The fill is NavigationViewSelectionIndicatorForeground,
                                    shared with the NavigationView and ListView/ListBox pills
                                    (SpecialBrushes.cs), not TreeViewItemSelectionIndicatorForeground's
                                    raw accent binding.
                                -->
                                <!--
                                    The item's own template sits inside one 20 dip indent per level (the
                                    ItemsPresenter margin below), so an indicator left at rest would step
                                    right with every level and the rail would walk down the tree. The
                                    depth is pulled back out in TreeViewItem.UpdateSelectionIndicatorIndent,
                                    which is the same split WinUI makes: indentation belongs to the
                                    content, never to the indicator beside it.
                                -->
                                <Border
                                    x:Name="SelectionIndicator"
                                    Width="3"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource NavigationViewSelectionIndicatorForeground}"
                                    CornerRadius="2"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                            </Grid>
                        </Border>

                        <!--  Children - indented 20 px per tree level (standard WPF tree indent)  -->
                        <ItemsPresenter
                            x:Name="ItemsHost"
                            Grid.Row="1"
                            Margin="20,0,0,0"
                            Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Expander" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger SourceName="ItemBorder" Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter TargetName="SelectionIndicator" Property="Opacity" Value="1" />
                        </Trigger>
                        <!--
                            IsSelectionChecked deliberately has no background trigger: in
                            Multiple mode the checkbox alone conveys the checked state, so
                            checking an item must not tint the row, matching WinUI TreeView
                            multi-select.
                        -->
                        <DataTrigger Binding="{Binding SelectionMode, RelativeSource={RelativeSource AncestorType={x:Type controls:TreeView}}}" Value="{x:Static fluence:TreeViewSelectionMode.Multiple}">
                            <Setter TargetName="SelectionCheckBox" Property="Visibility" Value="Visible" />
                            <!--  The checkbox is the selection read in Multiple mode, so the rail would be a second answer to the same question.  -->
                            <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition SourceName="ItemBorder" Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </MultiTrigger>
                        <!--
                            WinUI swaps to solid disabled fill/foreground tokens rather than fading
                            the whole row (TreeView_themeresources.xaml:8 TreeViewItemBackgroundDisabled
                            = SubtleFillColorDisabledBrush, :16 TreeViewItemForegroundDisabled =
                            TextFillColorDisabledBrush).
                        -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorDisabledBrush}" />
                        </Trigger>

                        <!--
                            A selected row that is disabled dims its indicator, which WinUI's
                            SelectedDisabled state does through TreeViewItemSelectionIndicatorForegroundDisabled
                            (TreeViewItem.xaml:88, resolved to TextFillColorDisabledBrush at
                            TreeView_themeresources.xaml:36) while holding its opacity at 1 (:92). The token is
                            deliberately outside the accent family that ListBox and ListView take for the same
                            state: WinUI drops the indicator out of accent entirely while the row cannot be acted on.
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsEnabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SelectionIndicator" Property="Background" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--
        Fluent TreeView style.
        Transparent background, no border, SmoothScrollViewer integration.
        ItemContainerStyle is NOT set here so that the default style lookup targets controls:TreeViewItem.
    -->
    <Style TargetType="{x:Type controls:TreeView}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{DynamicResource FluentFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.PanningMode" Value="Both" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TreeView}">
                    <Border
                        x:Name="OuterBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        ClipToBounds="True"
                        CornerRadius="{DynamicResource ControlCornerRadius}">
                        <controls:SmoothScrollViewer
                            x:Name="PART_ScrollViewer"
                            CanContentScroll="False"
                            Focusable="False"
                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            PanningMode="{TemplateBinding ScrollViewer.PanningMode}"
                            Style="{DynamicResource ScrollViewerStyle}"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter />
                        </controls:SmoothScrollViewer>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

</ResourceDictionary>
