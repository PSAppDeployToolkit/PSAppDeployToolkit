<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Fluence.Wpf.Controls">

    <Style TargetType="{x:Type controls:ProgressBar}">
        <!--  WinUI parity: ProgressBarBackground (ProgressBar_themeresources.xaml:7) is ControlStrongStrokeColorDefault and is the track's own TemplateBinding Background below, not a transparent placeholder.  -->
        <Setter Property="Background" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
        <!--  ProgressBarBorderBrush (:8); thickness stays 0 until high-contrast reintroduces the 1 px outline.  -->
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="MinHeight" Value="3.2" />
        <Setter Property="TrackHeight" Value="1" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ProgressBar}">
                    <Border
                        x:Name="RootBorder"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid MinHeight="3">
                            <!--  ProgressBarTrackCornerRadius (:29) is 0.5, distinct from the 1.5 ProgressBarCornerRadius used by the indicator fill below.  -->
                            <Border
                                x:Name="PART_Track"
                                Height="{TemplateBinding TrackHeight}"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0.5" />
                            <Grid
                                x:Name="ProgressBarIndicatorHost"
                                Height="{TemplateBinding MinHeight}"
                                VerticalAlignment="Center">
                                <!--
                                    The determinate fill is laid out once at the full track width and its
                                    progress is expressed by PART_FillScale (ScaleX in [0,1]), so per-value
                                    updates cost a composite instead of a layout + paint pass. It carries no
                                    CornerRadius of its own; the indicator host's rounded geometry clip owns
                                    the rounding, so scaling never distorts a radius.
                                -->
                                <Border
                                    x:Name="PART_Fill"
                                    Width="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="PART_FillScale" ScaleX="0" ScaleY="1" />
                                    </Border.RenderTransform>
                                </Border>
                                <Border
                                    x:Name="PART_IndeterminateBar"
                                    Width="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Visibility="Collapsed">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="PART_IndeterminateTranslate" X="0" />
                                    </Border.RenderTransform>
                                </Border>
                                <Border
                                    x:Name="PART_IndeterminateBar2"
                                    Width="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Visibility="Collapsed">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="PART_IndeterminateTranslate2" X="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Track" Property="Background" Value="{DynamicResource ControlStrongStrokeColorDisabledBrush}" />
                            <Setter TargetName="PART_Fill" Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Value" Value="0" />
    </Style>
</ResourceDictionary>
