<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Fluence.Wpf.Controls"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="SliderThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Height" Value="20" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid>
                        <!--
                            Outer capsule: fixed fill and stroke in every state (WinUI 3
                            SliderOuterThumbBackground / SliderThumbBorderBrush, Slider_themeresources.xaml:18-19,
                            carry no PointerOver/Pressed/Disabled variant). Only the inner dot below reacts to state.
                        -->
                        <Ellipse
                            x:Name="ThumbEllipse"
                            Width="20"
                            Height="20"
                            Fill="{DynamicResource ControlSolidFillColorDefaultBrush}"
                            Stroke="{DynamicResource ControlElevationBorderBrush}"
                            StrokeThickness="1" />
                        <Ellipse
                            x:Name="ThumbInnerDot"
                            Width="12"
                            Height="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource AccentFillColorDefaultBrush}"
                            RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="ThumbScale" ScaleX="0.86" ScaleY="0.86" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  WinUI canonical thumb inner-dot scale: rest 0.86, hover 1.167, pressed 0.71, disabled 1.167, all on ControlFastOutSlowIn (0,0,0,1). The duration is the one the target state calls for, as WinUI's own states do (Slider_themeresources.xaml:206-251): Normal and Disabled take ControlFastAnimationDuration (167 ms), PointerOver and Pressed take ControlNormalAnimationDuration (250 ms).  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbInnerDot" Property="Fill" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.25"
                                                Value="1.167" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.25"
                                                Value="1.167" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.167"
                                                Value="0.86" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.167"
                                                Value="0.86" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbInnerDot" Property="Fill" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.25"
                                                Value="0.71" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.25"
                                                Value="0.71" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.25"
                                                Value="1.167" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.25"
                                                Value="1.167" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ThumbInnerDot" Property="Fill" Value="{DynamicResource AccentFillColorDisabledBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ThumbScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1.167"
                                            Duration="0:0:0.167" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="ThumbScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1.167"
                                            Duration="0:0:0.167" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ThumbScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="0.86"
                                            Duration="0:0:0.167" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="ThumbScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="0.86"
                                            Duration="0:0:0.167" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Width" Value="20" />
    </Style>

    <Style x:Key="SliderTrackSegmentStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Grid VerticalAlignment="Stretch" Background="Transparent">
                        <Border
                            Height="4"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Background="{TemplateBinding Background}"
                            CornerRadius="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="SliderVerticalTrackSegmentStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Grid
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent">
                        <Border
                            Width="4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch"
                            Background="{TemplateBinding Background}"
                            CornerRadius="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style TargetType="{x:Type controls:Slider}">
        <!--  SliderTrackFill (Slider_themeresources.xaml:20): the unfilled track background, fixed across rest/hover/pressed.  -->
        <Setter Property="Background" Value="{DynamicResource ControlStrongFillColorDefaultBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Slider}">
                    <Grid
                        x:Name="Root"
                        Margin="6,0"
                        ClipToBounds="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid
                            x:Name="TrackHost"
                            Grid.Row="0"
                            Height="32"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            ClipToBounds="False">

                            <TickBar
                                x:Name="TopTick"
                                Height="4"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Fill="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                IsSelectionRangeEnabled="{TemplateBinding IsSelectionRangeEnabled}"
                                Maximum="{TemplateBinding Maximum}"
                                Minimum="{TemplateBinding Minimum}"
                                Placement="Top"
                                ReservedSpace="20"
                                SelectionEnd="{TemplateBinding SelectionEnd}"
                                SelectionStart="{TemplateBinding SelectionStart}"
                                TickFrequency="{TemplateBinding TickFrequency}"
                                Ticks="{TemplateBinding Ticks}"
                                Visibility="Collapsed" />

                            <TickBar
                                x:Name="BottomTick"
                                Height="4"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                Fill="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                IsSelectionRangeEnabled="{TemplateBinding IsSelectionRangeEnabled}"
                                Maximum="{TemplateBinding Maximum}"
                                Minimum="{TemplateBinding Minimum}"
                                Placement="Bottom"
                                ReservedSpace="20"
                                SelectionEnd="{TemplateBinding SelectionEnd}"
                                SelectionStart="{TemplateBinding SelectionStart}"
                                TickFrequency="{TemplateBinding TickFrequency}"
                                Ticks="{TemplateBinding Ticks}"
                                Visibility="Collapsed" />

                            <!--  SliderBorderThemeThickness is 0 (Slider_themeresources.xaml:7); WinUI draws no track stroke.  -->
                            <Border
                                x:Name="TrackBackground"
                                Height="4"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2" />

                            <Track
                                x:Name="PART_Track"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Focusable="False"
                                IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                Maximum="{TemplateBinding Maximum}"
                                Minimum="{TemplateBinding Minimum}"
                                Orientation="{TemplateBinding Orientation}"
                                Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Mode=TwoWay}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton
                                        x:Name="DecreaseButton"
                                        Background="{TemplateBinding Foreground}"
                                        Command="Slider.DecreaseLarge"
                                        Style="{StaticResource SliderTrackSegmentStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Style="{StaticResource SliderThumbStyle}" />
                                </Track.Thumb>
                                <!--
                                    IncreaseButton stays Transparent (SliderTrackSegmentStyle's default) so the
                                    unfilled track is painted exactly once, by TrackBackground below. WinUI's
                                    Slider template has one HorizontalTrackRect for the unfilled track plus
                                    HorizontalDecreaseRect for the filled part, not two stacked layers
                                    (Slider_themeresources.xaml). Giving this RepeatButton its own
                                    Background="{TemplateBinding Background}" would stack a second
                                    ControlStrongFillColorDefaultBrush layer over TrackBackground: the two
                                    partial-alpha fills compose to a darker unfilled track than WinUI shows.
                                -->
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton
                                        x:Name="IncreaseButton"
                                        Command="Slider.IncreaseLarge"
                                        Style="{StaticResource SliderTrackSegmentStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="TrackHost" Property="Height" Value="{x:Static sys:Double.NaN}" />
                            <Setter TargetName="TrackBackground" Property="Height" Value="{x:Static sys:Double.NaN}" />
                            <Setter TargetName="TopTick" Property="Height" Value="{x:Static sys:Double.NaN}" />
                            <Setter TargetName="BottomTick" Property="Height" Value="{x:Static sys:Double.NaN}" />
                            <Setter TargetName="TrackHost" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="TrackBackground" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="PART_Track" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="TopTick" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="BottomTick" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Root" Property="Margin" Value="0,6" />
                            <Setter TargetName="Root" Property="MinHeight" Value="0" />
                            <Setter TargetName="Root" Property="MinWidth" Value="40" />
                            <Setter TargetName="TopTick" Property="Placement" Value="Left" />
                            <Setter TargetName="BottomTick" Property="Placement" Value="Right" />
                            <Setter TargetName="DecreaseButton" Property="Style" Value="{StaticResource SliderVerticalTrackSegmentStyle}" />
                            <Setter TargetName="IncreaseButton" Property="Style" Value="{StaticResource SliderVerticalTrackSegmentStyle}" />
                            <Setter TargetName="TrackHost" Property="VerticalAlignment" Value="Stretch" />
                            <Setter TargetName="TrackBackground" Property="VerticalAlignment" Value="Stretch" />
                            <Setter TargetName="PART_Track" Property="VerticalAlignment" Value="Stretch" />
                            <Setter TargetName="TopTick" Property="VerticalAlignment" Value="Stretch" />
                            <Setter TargetName="BottomTick" Property="VerticalAlignment" Value="Stretch" />
                            <Setter TargetName="TrackHost" Property="Width" Value="32" />
                            <Setter TargetName="TrackBackground" Property="Width" Value="4" />
                            <Setter TargetName="PART_Track" Property="Width" Value="32" />
                            <Setter TargetName="TopTick" Property="Width" Value="4" />
                            <Setter TargetName="BottomTick" Property="Width" Value="4" />
                        </Trigger>

                        <!--
                            SliderTrackFillPointerOver / Pressed both equal SliderTrackFill (Slider_themeresources.xaml:20-22),
                            so the unfilled track never changes color on hover or drag; only the accent value fill
                            (DecreaseButton) reacts, per SliderTrackValueFillPointerOver/Pressed (:25-26).
                        -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="DecreaseButton" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger SourceName="Thumb" Property="IsDragging" Value="True">
                            <Setter TargetName="DecreaseButton" Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="TrackBackground" Property="Background" Value="{DynamicResource ControlStrongFillColorDisabledBrush}" />
                            <Setter TargetName="DecreaseButton" Property="Background" Value="{DynamicResource AccentFillColorDisabledBrush}" />
                            <Setter TargetName="TopTick" Property="Fill" Value="{DynamicResource ControlStrongFillColorDisabledBrush}" />
                            <Setter TargetName="BottomTick" Property="Fill" Value="{DynamicResource ControlStrongFillColorDisabledBrush}" />
                        </Trigger>

                        <Trigger Property="TickPlacement" Value="TopLeft">
                            <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="TickPlacement" Value="BottomRight">
                            <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="TickPlacement" Value="Both">
                            <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseLayoutRounding" Value="True" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="MinWidth" Value="40" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
