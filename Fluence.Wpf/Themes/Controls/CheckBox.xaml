<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Fluence.Wpf.Controls">

    <Style TargetType="{x:Type controls:CheckBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="FontFamily" Value="{DynamicResource FluentFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <!--  WinUI parity: DefaultCheckBoxStyle sets HorizontalAlignment=Left (CheckBox_themeresources.xaml:284) so the box and label hug the left edge instead of stretching across the parent.  -->
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="8,5,0,0" />
        <Setter Property="MinHeight" Value="32" />
        <!--  WinUI parity: DefaultCheckBoxStyle sets MinWidth to CheckBoxMinWidth, 120 (CheckBox_themeresources.xaml:273,290).  -->
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:CheckBox}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MinHeight="32" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border
                            x:Name="IndicatorHost"
                            Grid.Row="0"
                            Grid.Column="0"
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            UseLayoutRounding="False">
                            <Grid>
                                <!--
                                    Opaque sub-layer under the IndicatorChecked stack so accent
                                    hover/press fills (AccentFillColorSecondary 0.9 / Tertiary 0.8
                                    / Disabled) composite against a surface-matched solid rather
                                    than whatever translucent form / card / Mica sits beneath
                                    the checkbox. Visible only when IsChecked is True or null
                                    (indeterminate).
                                -->
                                <Border
                                    x:Name="IndicatorAccentBackdrop"
                                    Background="{DynamicResource AccentFillBackdropBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Opacity="0" />
                                <Border
                                    x:Name="IndicatorFill"
                                    Background="{DynamicResource ControlAltFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{TemplateBinding CornerRadius}" />
                                <Border
                                    x:Name="IndicatorHover"
                                    Background="{DynamicResource ControlAltFillColorTertiaryBrush}"
                                    BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Opacity="0" />
                                <Border
                                    x:Name="IndicatorPressed"
                                    Background="{DynamicResource ControlAltFillColorQuarternaryBrush}"
                                    BorderBrush="{DynamicResource ControlStrongStrokeColorDisabledBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Opacity="0" />
                                <Border
                                    x:Name="IndicatorChecked"
                                    Background="{DynamicResource CheckBoxCheckBackgroundFillCheckedBrush}"
                                    BorderBrush="{DynamicResource CheckBoxCheckBackgroundFillCheckedBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Opacity="0" />
                                <Border
                                    x:Name="IndicatorCheckedHover"
                                    Background="{DynamicResource CheckBoxCheckBackgroundFillCheckedPointerOverBrush}"
                                    BorderBrush="{DynamicResource CheckBoxCheckBackgroundFillCheckedPointerOverBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Opacity="0" />
                                <Border
                                    x:Name="IndicatorCheckedPressed"
                                    Background="{DynamicResource CheckBoxCheckBackgroundFillCheckedPressedBrush}"
                                    BorderBrush="{DynamicResource CheckBoxCheckBackgroundFillCheckedPressedBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Opacity="0" />
                                <!-- Fixed 20-DIP geometry derived from Microsoft's AnimatedAcceptVisualSource.cpp
                                     at WinUI Gallery pin 7b127093; C# owns route trim and visibility. -->
                                <Path
                                    x:Name="PART_CheckGlyph"
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M 5.354,9.567 L 8.469,12.683 L 14.697,6.397"
                                    Fill="{x:Null}"
                                    Margin="0,1,0,-1"
                                    Opacity="0"
                                    Stretch="None"
                                    Stroke="{DynamicResource CheckBoxCheckGlyphForegroundCheckedBrush}"
                                    StrokeDashArray="10.8202544583,10.8202544583"
                                    StrokeDashCap="Round"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.225"
                                    UseLayoutRounding="False">
                                </Path>
                                <Path
                                    x:Name="PART_IndeterminateGlyph"
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M 6.402,9.962 L 13.637,9.962"
                                    Fill="{x:Null}"
                                    Opacity="0"
                                    Stretch="None"
                                    Stroke="{DynamicResource CheckBoxCheckGlyphForegroundIndeterminateBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.225"
                                    UseLayoutRounding="False" />
                            </Grid>
                        </Border>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            RecognizesAccessKey="True"
                            TextElement.FontFamily="{TemplateBinding FontFamily}"
                            TextElement.FontSize="{TemplateBinding FontSize}"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                        <TextBlock
                            x:Name="DescriptionText"
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="28,4,0,0"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{TemplateBinding Description}"
                            TextWrapping="Wrap"
                            Visibility="Visible" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="IndicatorHover" Property="Opacity" Value="1" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="IndicatorCheckedHover" Property="Opacity" Value="1" />
                            <Setter TargetName="IndicatorChecked" Property="Opacity" Value="0" />
                            <Setter TargetName="IndicatorCheckedHover" Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillIndeterminatePointerOverBrush}" />
                            <Setter TargetName="IndicatorCheckedHover" Property="BorderBrush" Value="{DynamicResource CheckBoxCheckBackgroundStrokeIndeterminatePointerOverBrush}" />
                            <Setter TargetName="PART_IndeterminateGlyph" Property="Stroke" Value="{DynamicResource CheckBoxCheckGlyphForegroundIndeterminatePointerOverBrush}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="IndicatorPressed" Property="Opacity" Value="1" />
                        </MultiTrigger>
                        <!--  WinUI parity: CheckBoxCheckGlyphForegroundIndeterminatePressed (CheckBox_themeresources.xaml:75) is TextOnAccentFillColorSecondaryBrush; the Fluence indeterminate glyph is IndeterminateDash.  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsChecked" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="IndicatorCheckedPressed" Property="Opacity" Value="1" />
                            <Setter TargetName="IndicatorChecked" Property="Opacity" Value="0" />
                            <Setter TargetName="IndicatorCheckedHover" Property="Opacity" Value="0" />
                            <Setter TargetName="IndicatorCheckedPressed" Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillIndeterminatePressedBrush}" />
                            <Setter TargetName="IndicatorCheckedPressed" Property="BorderBrush" Value="{DynamicResource CheckBoxCheckBackgroundFillIndeterminatePressedBrush}" />
                            <Setter TargetName="PART_IndeterminateGlyph" Property="Stroke" Value="{DynamicResource CheckBoxCheckGlyphForegroundIndeterminatePressedBrush}" />
                        </MultiTrigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="IndicatorFill" Property="Opacity" Value="0" />
                            <Setter TargetName="IndicatorHover" Property="Opacity" Value="0" />
                            <Setter TargetName="IndicatorPressed" Property="Opacity" Value="0" />
                            <Setter TargetName="IndicatorChecked" Property="Opacity" Value="1" />
                            <Setter TargetName="IndicatorAccentBackdrop" Property="Opacity" Value="1" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsPressed" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="IndicatorChecked" Property="Opacity" Value="0" />
                            <Setter TargetName="IndicatorCheckedHover" Property="Opacity" Value="1" />
                            <Setter TargetName="PART_CheckGlyph" Property="Stroke" Value="{DynamicResource CheckBoxCheckGlyphForegroundCheckedPointerOverBrush}" />
                        </MultiTrigger>
                        <!--  WinUI parity: CheckBoxCheckGlyphForegroundCheckedPressed (CheckBox_themeresources.xaml:71) is TextOnAccentFillColorSecondaryBrush, not the rest-state Primary.  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="IndicatorChecked" Property="Opacity" Value="0" />
                            <Setter TargetName="IndicatorCheckedHover" Property="Opacity" Value="0" />
                            <Setter TargetName="IndicatorCheckedPressed" Property="Opacity" Value="1" />
                            <Setter TargetName="PART_CheckGlyph" Property="Stroke" Value="{DynamicResource CheckBoxCheckGlyphForegroundCheckedPressedBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="IndicatorCheckedPressed" Property="Opacity" Value="1" />
                            <Setter TargetName="IndicatorCheckedHover" Property="Opacity" Value="0" />
                        </MultiTrigger>

                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="IndicatorFill" Property="Opacity" Value="0" />
                            <Setter TargetName="IndicatorHover" Property="Opacity" Value="0" />
                            <Setter TargetName="IndicatorPressed" Property="Opacity" Value="0" />
                            <Setter TargetName="IndicatorChecked" Property="Opacity" Value="1" />
                            <Setter TargetName="IndicatorChecked" Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillIndeterminateBrush}" />
                            <Setter TargetName="IndicatorChecked" Property="BorderBrush" Value="{DynamicResource CheckBoxCheckBackgroundFillIndeterminateBrush}" />
                            <Setter TargetName="IndicatorAccentBackdrop" Property="Opacity" Value="1" />
                        </Trigger>

                        <!--  WinUI parity: CheckBoxCheckBackgroundStrokeCheckedDisabled (CheckBox_themeresources.xaml:48) is ControlStrongStrokeColorDisabledBrush, the stroke family, not AccentFillColorDisabledBrush (same resolved value, wrong family). The Fluence-only opaque IndicatorAccentBackdrop plate must also drop out while disabled.  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsEnabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="IndicatorChecked" Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillCheckedDisabledBrush}" />
                            <Setter TargetName="IndicatorCheckedHover" Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillCheckedDisabledBrush}" />
                            <Setter TargetName="IndicatorCheckedPressed" Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillCheckedDisabledBrush}" />
                            <Setter TargetName="IndicatorChecked" Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDisabledBrush}" />
                            <Setter TargetName="IndicatorCheckedHover" Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDisabledBrush}" />
                            <Setter TargetName="IndicatorCheckedPressed" Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDisabledBrush}" />
                            <Setter TargetName="IndicatorAccentBackdrop" Property="Opacity" Value="0" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter TargetName="PART_CheckGlyph" Property="Stroke" Value="{DynamicResource CheckBoxCheckGlyphForegroundCheckedDisabledBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="{x:Null}" />
                                <Condition Property="IsEnabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="IndicatorChecked" Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillIndeterminateDisabledBrush}" />
                            <Setter TargetName="IndicatorCheckedHover" Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillIndeterminateDisabledBrush}" />
                            <Setter TargetName="IndicatorCheckedPressed" Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillIndeterminateDisabledBrush}" />
                            <Setter TargetName="IndicatorCheckedHover" Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDisabledBrush}" />
                            <Setter TargetName="IndicatorCheckedPressed" Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDisabledBrush}" />
                            <Setter TargetName="PART_IndeterminateGlyph" Property="Stroke" Value="{DynamicResource CheckBoxCheckGlyphForegroundIndeterminateDisabledBrush}" />
                            <Setter TargetName="IndicatorChecked" Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDisabledBrush}" />
                            <Setter TargetName="IndicatorAccentBackdrop" Property="Opacity" Value="0" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsEnabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="IndicatorFill" Property="Background" Value="{DynamicResource ControlAltFillColorDisabledBrush}" />
                            <Setter TargetName="IndicatorFill" Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDisabledBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
</ResourceDictionary>
