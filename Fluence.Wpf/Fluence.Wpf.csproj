<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <TargetFrameworks>net472;net8.0-windows10.0.26100.0;net10.0-windows10.0.26100.0</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <RootNamespace>Fluence.Wpf</RootNamespace>
    <AssemblyName>Fluence.Wpf</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);SYSLIB1045;SYSLIB1054;S1244</NoWarn>
    <DocumentationFile Condition="'$(TargetFramework)' != ''">bin/$(Configuration)/$(TargetFramework)/Fluence.Wpf.xml</DocumentationFile>
    <Description>Windows 11 Fluent Design controls and theming for WPF (.NET Framework 4.7.2, .NET 8, and .NET 10)</Description>
    <Product>Fluence.Wpf</Product>
    <Title>Fluence.Wpf</Title>
    <PackageId>Fluence.Wpf</PackageId>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sintaxasn/Fluence.Wpf</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sintaxasn/Fluence.Wpf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>wpf;fluent;fluent-design;windows11;controls;theme</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Fluence_Icon_Light_128.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <Page Update="Properties\DesignTimeResources.xaml" Condition="'$(DesignTime)'=='true' OR ('$(SolutionPath)'!='' AND Exists('$(SolutionPath)') AND '$(BuildingInsideVisualStudio)'!='true' AND '$(BuildingInsideExpressionBlend)'!='true')">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
      <ContainsDesignTimeResources>true</ContainsDesignTimeResources>
    </Page>
  </ItemGroup>

  <ItemGroup Label="NuGet package content">
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\assets\Fluence_Icon_Light_128.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Label="Embedded window icon">
    <Resource Include="Themes\Icons\Fluence_Icon_NoBackground_256.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Tasks.Git">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    PublicApiAnalyzers freezes the public CLR surface. RS0016 fails the build on an undeclared
    public member and RS0017 on a declared member that has disappeared. The library multi-targets
    and the surface is allowed to differ by TFM, so each TFM owns its own pair of tracking files.
    The three pairs happen to be identical today, since nothing in the public surface is
    conditioned on the target framework; the split is what keeps a future per-TFM member from
    silently entering every baseline at once.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    One public surface baseline shared by all three target frameworks: the surface is identical
    across them today. A framework-specific member would fail RS0016 or RS0017 for that framework
    alone, which is the moment to move the pair under PublicAPI\$(TargetFramework)\ and split it.
  -->
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI\PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI\PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Meziantou.Polyfill">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Bcl.Memory" />
    <PackageReference Include="System.Memory" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows10.0.26100.0'">
    <PackageReference Include="Meziantou.Polyfill">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
