<!--
    Copyright (C) 2026 Dan Cunningham. All rights reserved.

    Colors design-reference page, modelled on the WinUI 3 Gallery Color page
    (WinUIGallery/Samples/Color/ColorPage.xaml and Controls/DesignGuidance/ColorSections/*.xaml):
    an intro sentence, the one-line brush snippet, and six sections (Text, Fill, Stroke,
    Background, Signal, High Contrast) each made of ColorPageExample cards followed by rows of
    ColorTile swatches painted in their own brushes. The section data lives in
    GalleryColorsPage.xaml.cs.

    Layout follows the Gallery page too: a Grid rather than the scrolling StackPanel the other
    gallery pages use, so the header, the intro, the snippet and the SelectorBar stay locked in
    place and only the section content scrolls (ColorPage.xaml puts its ScrollViewer in the last
    star row and suppresses host scrolling). The section content keeps an equal gutter on both
    sides inside its scroll host, so the scrollbar sits in the right-hand gutter rather than under
    the cards or against the window edge.

    Deviations from the Gallery, all forced by the platform:
    - WPF has no per-element system backdrop, so the Acrylic and Mica tiles show their fallback brushes.
    - The tile-less Mica Background group is omitted: WPF has no per-element Mica.
    - High Contrast shows one grid of the live SystemColor* aliases instead of four hard-coded palettes.
-->
<Page
    x:Class="Fluence.Wpf.Demo.Pages.GalleryColorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fluence="http://schemas.fluencewpf.com"
    xmlns:local="clr-namespace:Fluence.Wpf.Demo.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="900"
    d:DesignWidth="980"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Grid x:Name="PageRoot" Style="{StaticResource GalleryPageRootStyle}">
        <Grid x:Name="PageContent" Style="{StaticResource GalleryPageContentGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <local:GalleryPageHeader
                Title="Colors"
                ControlSourcePath="Fluence.Wpf/Themes/Colors/Theme.Light.xaml"
                DocsAnchor="canonical-token-families"
                DocsDocument="theming.md" />
            <TextBlock
                Grid.Row="1"
                Margin="{DynamicResource DemoNoMargin}"
                Style="{StaticResource SectionDescriptionStyle}"
                Text="The brushes below ship with Fluence and you can reference them in your app. For example:" />

            <!--  WinUI Gallery ColorPage.xaml: SampleCodePresenter (inline, IsCopyButtonVisible="False").  -->
            <local:DemoCodePresenter
                Grid.Row="2"
                Margin="{DynamicResource DemoCodePresenterMargin}"
                Code="&lt;TextBlock Text=&quot;...&quot; Foreground=&quot;{DynamicResource TextFillColorPrimaryBrush}&quot; /&gt;"
                CodeLanguage="Xaml"
                IsCopyButtonVisible="False" />

            <!--
                WinUI Gallery ColorPage.xaml: a SelectorBar with one section page per item, whose
                SelectionChanged navigates a Frame with a SlideNavigationTransitionInfo. The
                section content is built in code from the section table and handed to the
                SlideNavigationPresenter, which plays the same transition.
            -->
            <fluence:SelectorBar
                x:Name="ColorSectionSelector"
                Grid.Row="3"
                Margin="{DynamicResource DemoColorSelectorBarMargin}">
                <fluence:SelectorBarItem Text="Text" />
                <fluence:SelectorBarItem Text="Fill" />
                <fluence:SelectorBarItem Text="Stroke" />
                <fluence:SelectorBarItem Text="Background" />
                <fluence:SelectorBarItem Text="Signal" />
                <fluence:SelectorBarItem Text="High Contrast" />
            </fluence:SelectorBar>

            <!--
                The scroll host lives inside the presenter, one per section, so the scrollbar
                belongs to the section that is showing and travels with it through the slide.
                Each section's scroll viewer takes focus on click, which is what gives Home, End,
                Page Up and Page Down to the content while the SelectorBar keeps the arrow keys.
            -->
            <fluence:SlideNavigationPresenter
                x:Name="ColorSectionPresenter"
                Grid.Row="4" />
        </Grid>
    </Grid>
</Page>
