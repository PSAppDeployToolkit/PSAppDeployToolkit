<Page
    x:Class="Fluence.Wpf.Demo.Pages.GalleryLayoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluence="http://schemas.fluencewpf.com"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Fluence.Wpf.Demo.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="900"
    d:DesignWidth="900"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Grid x:Name="PageRoot" Style="{StaticResource GalleryPageRootStyle}">
        <Grid x:Name="PageContent" Style="{StaticResource GalleryPageContentGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <local:GalleryPageHeader DocsAnchor="layout-and-surfaces" Title="Layout" />
            <TextBlock Grid.Row="1" Style="{StaticResource SectionDescriptionStyle}" Text="Layout primitives arrange content, group related surfaces, and separate regions without adding page-specific infrastructure." />

            <fluence:SmoothScrollViewer
                Grid.Row="2"
                Margin="{DynamicResource DemoPageScrollHostMargin}"
                Style="{StaticResource GalleryPageScrollViewerStyle}">
                <StackPanel Margin="{DynamicResource DemoPageScrollContentMargin}">


                    <ContentControl x:Name="DemoSampleSlot01DemoContentHost" Visibility="Collapsed">
                        <fluence:Border
                            Padding="{DynamicResource DemoSampleInnerCardPadding}"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource OverlayCornerRadius}">
                            <fluence:StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Settings group" />
                                <TextBlock
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="StackPanel spacing keeps rows readable while Border frames the group."
                                    TextWrapping="Wrap" />
                                <fluence:Separator />
                                <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Separator divides related rows." />
                            </fluence:StackPanel>
                        </fluence:Border>
                    </ContentControl>
                    <local:DemoSampleControl SampleDescription="Use Border to frame a region, StackPanel spacing for readable rows, and Separator to divide related content." />

                    <ContentControl x:Name="DemoSampleSlot02DemoContentHost" Visibility="Collapsed">
                        <fluence:DockPanel LastChildFill="True" Spacing="12">
                            <fluence:Button
                                Appearance="Accent"
                                Content="Apply"
                                DockPanel.Dock="Right" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="DockPanel keeps the command aligned to the edge." />
                        </fluence:DockPanel>
                    </ContentControl>
                    <local:DemoSampleControl SampleDescription="Use DockPanel when one element should pin to an edge while the remaining content fills the available space." />

                    <ContentControl x:Name="DemoSampleSlot03DemoContentHost" Visibility="Collapsed">
                        <fluence:Expander x:Name="AdvancedOptionsExpander" Header="Advanced options">
                            <TextBlock
                                Margin="{DynamicResource DemoLargeTopGapMargin}"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Expander shows secondary settings only when they are useful."
                                TextWrapping="Wrap" />
                        </fluence:Expander>
                    </ContentControl>
                    <local:DemoSampleControl SampleDescription="Use Expander for secondary settings that should start collapsed until needed." />

                    <ContentControl x:Name="DemoSampleSlot04DemoContentHost" Visibility="Collapsed">
                        <fluence:Expander x:Name="DockPanelOptionsExpander">
                            <fluence:Expander.Header>
                                <fluence:DockPanel LastChildFill="True" Spacing="8">
                                    <fluence:Button Content="Edit" DockPanel.Dock="Right" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="Delivery options" />
                                </fluence:DockPanel>
                            </fluence:Expander.Header>
                            <fluence:DockPanel Margin="0,16,0,0" LastChildFill="True" Spacing="8">
                                <fluence:ToggleSwitch
                                    DockPanel.Dock="Right"
                                    OffContent="Off"
                                    OnContent="On" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="Notify me when the package ships."
                                    TextWrapping="Wrap" />
                            </fluence:DockPanel>
                        </fluence:Expander>
                    </ContentControl>
                    <local:DemoSampleControl SampleDescription="Use DockPanel inside Expander headers and content when the summary and secondary action need edge alignment." />

                    <ContentControl x:Name="DemoSampleSlot05DemoContentHost" Visibility="Collapsed">
                        <fluence:SmoothScrollViewer
                            Height="180"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Visible">
                            <fluence:StackPanel Spacing="8">
                                <TextBlock Text="Scroll this list to see the remaining items." />
                                <TextBlock Text="Item 1 - Planning" />
                                <TextBlock Text="Item 2 - Design" />
                                <TextBlock Text="Item 3 - Build" />
                                <TextBlock Text="Item 4 - Review" />
                                <TextBlock Text="Item 5 - Release" />
                                <TextBlock Text="Item 6 - Follow-up" />
                                <TextBlock Text="Item 7 - Support" />
                                <TextBlock Text="Item 8 - Archive" />
                                <TextBlock Text="End of the list" />
                            </fluence:StackPanel>
                        </fluence:SmoothScrollViewer>
                    </ContentControl>
                    <local:DemoSampleControl SampleDescription="Use SmoothScrollViewer for a constrained list; its Fluence scrollbar shows the scroll position." />
                </StackPanel>
            </fluence:SmoothScrollViewer>
        </Grid>
    </Grid>
</Page>
