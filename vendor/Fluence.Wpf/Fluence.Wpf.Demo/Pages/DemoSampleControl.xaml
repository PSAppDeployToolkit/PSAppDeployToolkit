<ContentControl
    x:Class="Fluence.Wpf.Demo.Pages.DemoSampleControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluence="http://schemas.fluencewpf.com"
    x:Name="Root">
    <Grid Margin="{DynamicResource DemoSampleBlockMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="SampleDescriptionTextBlock"
            Grid.Row="0"
            Margin="{DynamicResource DemoSampleDescriptionMargin}"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="{Binding SampleDescription, ElementName=Root}"
            TextWrapping="Wrap" />

        <Border
            x:Name="SampleCard"
            Grid.Row="1"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8,8,0,0">
            <Grid x:Name="SampleContentGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid
                    x:Name="DemoRegionGrid"
                    Grid.Column="0"
                    MinHeight="{DynamicResource DemoSampleDemoAreaMinHeight}"
                    Margin="{DynamicResource DemoSampleCardPadding}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ContentPresenter
                        x:Name="DemoContentPresenter"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Content="{Binding DemoContent, ElementName=Root}" />

                    <Border
                        x:Name="OutputRegion"
                        Grid.Column="1"
                        MinWidth="{DynamicResource DemoSampleOutputMinWidth}"
                        Margin="{DynamicResource DemoSampleOutputMargin}"
                        Padding="{DynamicResource DemoSampleOutputPadding}"
                        VerticalAlignment="Center"
                        CornerRadius="{DynamicResource ControlCornerRadius}">
                        <StackPanel>
                            <TextBlock Text="Output:" />
                            <ContentPresenter x:Name="OutputContentPresenter" Content="{Binding OutputContent, ElementName=Root}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!--
                    CornerRadius 0,8,0,0 keeps the rail's fill inside SampleCard's rounded
                    top-right arc: a WPF Border does not clip children, so a square rail
                    corner would overpaint the card's 8px outline and stroke.
                -->
                <Border
                    x:Name="RightRailBorder"
                    Grid.Column="1"
                    MinWidth="{DynamicResource DemoSampleRightRailMinWidth}"
                    Padding="{DynamicResource DemoSampleRightRailPadding}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0"
                    CornerRadius="0,8,0,0">
                    <ContentPresenter x:Name="RightRailContentPresenter" Content="{Binding RightRailContent, ElementName=Root}" />
                </Border>
            </Grid>
        </Border>

        <!--
            The stock Expander, configured the way the WinUI Gallery configures its own
            (WinUIGallery/Controls/ControlExample.xaml:207-218): no padding of its own, stretched
            across the card, the card secondary fill, and only the bottom corners rounded so the
            source section reads as the lower half of the sample card above it. The demo used to
            carry a copy of the control's template here; the control owns the header, the chevron
            and the expand slide now.
        -->
        <fluence:Expander
            x:Name="SourceExpander"
            Grid.Row="2"
            Padding="0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
            CornerRadius="0,0,8,8"
            Expanded="SourceExpander_Expanded"
            Header="Source code">
            <!--
                WinUI Gallery ControlExample.xaml: a SelectorBar of XAML / C# items above the
                code presenters, not a TabControl.
            -->
            <Grid Margin="{DynamicResource DemoSampleSourceTabMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <fluence:SelectorBar
                    x:Name="SourceSelector"
                    Margin="{DynamicResource DemoSampleSourceSelectorMargin}"
                    SelectionChanged="SourceSelector_SelectionChanged" />
                <ContentControl x:Name="SourceContentHost" Grid.Row="1" />
            </Grid>
        </fluence:Expander>
    </Grid>
</ContentControl>
