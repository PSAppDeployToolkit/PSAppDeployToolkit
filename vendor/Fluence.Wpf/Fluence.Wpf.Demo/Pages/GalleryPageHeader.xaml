    Shared gallery page header, modelled on the WinUI 3 Gallery's Controls/PageHeader.xaml:
    the page title on its own row, then an action row with the Documentation and Source
    drop-downs on the left and the theme toggle, copy-link and favorite buttons on the right.
    See GalleryPageHeader.xaml.cs.
-->
<UserControl
    x:Class="Fluence.Wpf.Demo.Pages.GalleryPageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fluence="http://schemas.fluencewpf.com"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  WinUI PageHeader row 0: TitleTextBlockStyle, no trailing controls.  -->
        <TextBlock
            x:Name="TitleTextBlock"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="{Binding Title, ElementName=Root}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />

        <!--  WinUI PageHeader row 1 (Margin 0,12,0,12): Documentation and Source drop-downs left, actions right.  -->
        <Grid Grid.Row="1" Margin="{DynamicResource DemoPageHeaderActionRowMargin}">
            <fluence:StackPanel
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Spacing="{DynamicResource DemoPageHeaderActionSpacing}">
                <fluence:DropDownButton
                    x:Name="DocsDropDownButton"
                    Height="{DynamicResource DemoPageHeaderButtonHeight}"
                    AutomationProperties.Name="Documentation"
                    ToolTip="Documentation">
                    <fluence:DropDownButton.Content>
                        <fluence:StackPanel Orientation="Horizontal" Spacing="{DynamicResource DemoPageHeaderDropDownContentSpacing}">
                            <fluence:FontIcon
                                VerticalAlignment="Center"
                                Glyph="&#xE8A5;"
                                IconFontSize="{DynamicResource DemoPageHeaderIconFontSize}" />
                            <TextBlock VerticalAlignment="Center" Text="Documentation" />
                        </fluence:StackPanel>
                    </fluence:DropDownButton.Content>
                    <fluence:DropDownButton.Flyout>
                        <StackPanel MinWidth="{DynamicResource DemoPageHeaderFlyoutMinWidth}" Margin="{DynamicResource DemoSampleInnerCardPadding}">
                            <fluence:HyperlinkButton
                                x:Name="DocsLink"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left" />
                        </StackPanel>
                    </fluence:DropDownButton.Flyout>
                </fluence:DropDownButton>
                <fluence:DropDownButton
                    x:Name="SourceDropDownButton"
                    Height="{DynamicResource DemoPageHeaderButtonHeight}"
                    AutomationProperties.Name="Source code"
                    ToolTip="Source code of this sample page">
                    <fluence:DropDownButton.Content>
                        <fluence:StackPanel Orientation="Horizontal" Spacing="{DynamicResource DemoPageHeaderDropDownContentSpacing}">
                            <Path
                                Width="{DynamicResource DemoPageHeaderIconFontSize}"
                                Height="{DynamicResource DemoPageHeaderIconFontSize}"
                                VerticalAlignment="Center"
                                Data="{StaticResource DemoGitHubIconGeometry}"
                                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=fluence:DropDownButton}}"
                                Stretch="Uniform" />
                            <TextBlock VerticalAlignment="Center" Text="Source" />
                        </fluence:StackPanel>
                    </fluence:DropDownButton.Content>
                    <fluence:DropDownButton.Flyout>
                        <StackPanel MinWidth="{DynamicResource DemoPageHeaderFlyoutMinWidth}" Margin="{DynamicResource DemoSampleInnerCardPadding}">
                            <StackPanel x:Name="ControlSourcePanel">
                                <TextBlock
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Control source code" />
                                <fluence:HyperlinkButton
                                    x:Name="ControlSourceLink"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" />
                                <fluence:Separator Margin="{DynamicResource DemoPageHeaderFlyoutSeparatorMargin}" />
                            </StackPanel>
                            <StackPanel x:Name="PageSourcePanel">
                                <TextBlock
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Sample page source code" />
                                <fluence:HyperlinkButton
                                    x:Name="PageXamlLink"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Content="XAML" />
                                <fluence:HyperlinkButton
                                    x:Name="PageCodeLink"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Content="C#" />
                            </StackPanel>
                        </StackPanel>
                    </fluence:DropDownButton.Flyout>
                </fluence:DropDownButton>
            </fluence:StackPanel>

            <fluence:StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="{DynamicResource DemoPageHeaderActionSpacing}">
                <fluence:Button
                    x:Name="ThemeToggleButton"
                    Height="{DynamicResource DemoPageHeaderButtonHeight}"
                    MinHeight="{DynamicResource DemoPageHeaderButtonHeight}"
                    MinWidth="{DynamicResource DemoPageHeaderActionButtonMinWidth}"
                    Padding="{DynamicResource DemoSourceCopyButtonPadding}"
                    AutomationProperties.Name="Toggle theme"
                    Click="ThemeToggleButton_Click"
                    ToolTip="Toggle theme">
                    <fluence:Button.Icon>
                        <fluence:FontIcon Glyph="&#xE793;" IconFontSize="{DynamicResource DemoPageHeaderIconFontSize}" />
                    </fluence:Button.Icon>
                </fluence:Button>
                <!--  WinUI AppBarSeparator between the theme toggle and the copy-link button.  -->
                <fluence:Border
                    Width="{DynamicResource DemoPageHeaderSeparatorWidth}"
                    Margin="{DynamicResource DemoPageHeaderSeparatorMargin}"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <fluence:Button
                    x:Name="CopyLinkButton"
                    Height="{DynamicResource DemoPageHeaderButtonHeight}"
                    MinHeight="{DynamicResource DemoPageHeaderButtonHeight}"
                    MinWidth="{DynamicResource DemoPageHeaderActionButtonMinWidth}"
                    Padding="{DynamicResource DemoSourceCopyButtonPadding}"
                    AutomationProperties.Name="Copy link"
                    Click="CopyLinkButton_Click"
                    ToolTip="Copy link">
                    <fluence:Button.Icon>
                        <fluence:FontIcon Glyph="&#xE71B;" IconFontSize="{DynamicResource DemoPageHeaderIconFontSize}" />
                    </fluence:Button.Icon>
                </fluence:Button>
                <fluence:ToggleButton
                    x:Name="FavoriteToggleButton"
                    Height="{DynamicResource DemoPageHeaderButtonHeight}"
                    MinHeight="{DynamicResource DemoPageHeaderButtonHeight}"
                    MinWidth="{DynamicResource DemoPageHeaderActionButtonMinWidth}"
                    Padding="{DynamicResource DemoSourceCopyButtonPadding}"
                    AutomationProperties.Name="Add to favorites"
                    Checked="FavoriteToggleButton_CheckedChanged"
                    ToolTip="Add to favorites"
                    Unchecked="FavoriteToggleButton_CheckedChanged">
                    <fluence:FontIcon
                        x:Name="FavoriteIcon"
                        Glyph="&#xE734;"
                        IconFontSize="{DynamicResource DemoPageHeaderIconFontSize}" />
                </fluence:ToggleButton>
            </fluence:StackPanel>
        </Grid>
    </Grid>
</UserControl>
