<Page
    x:Class="Fluence.Wpf.Demo.Pages.GalleryTypographyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluence="http://schemas.fluencewpf.com"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Fluence.Wpf.Demo.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="800"
    d:DesignWidth="900"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Grid x:Name="PageRoot" Style="{StaticResource GalleryPageRootStyle}">
        <Grid x:Name="PageContent" Style="{StaticResource GalleryPageContentGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <local:GalleryPageHeader DocsAnchor="typography-1" Title="Typography" />
            <TextBlock Grid.Row="1" Style="{StaticResource SectionDescriptionStyle}" Text="Fluent type styles use Segoe UI Variable when available and fall back to Segoe UI." />

            <fluence:SmoothScrollViewer
                Grid.Row="2"
                Margin="{DynamicResource DemoPageScrollHostMargin}"
                Style="{StaticResource GalleryPageScrollViewerStyle}">
                <StackPanel Margin="{DynamicResource DemoPageScrollContentMargin}">

                    <!--  WinUI Gallery Typography page: the type ramp table is a ControlExample with source, not a bare catalog.  -->
                    <ContentControl x:Name="DemoSampleSlot01DemoContentHost" Visibility="Collapsed">
                        <Grid x:Name="TypographyTable" HorizontalAlignment="Stretch">
                            <!--  Star weights reproduce the Gallery's measured column widths (137 / 111 / 203 dip at its own content width). The minimums stay well under those so the star columns give way before the row can grow past the card and clip the copy button.  -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="180" />
                                <ColumnDefinition Width="1.2*" MinWidth="100" />
                                <ColumnDefinition Width="1*" MinWidth="84" />
                                <ColumnDefinition Width="1.7*" MinWidth="130" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ContentControl>
                    <local:DemoSampleControl SampleDescription="Type ramp" />
                </StackPanel>
            </fluence:SmoothScrollViewer>
        </Grid>
    </Grid>
</Page>
