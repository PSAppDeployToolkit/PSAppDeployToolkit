<fluence:FluenceWindow
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluence="http://schemas.fluencewpf.com"
    Title="Fluence.Wpf - PowerShell"
    Width="840"
    Height="740"
    MinWidth="640"
    MinHeight="520"
    CornerStyle="Round"
    ExtendsContentIntoTitleBar="False"
    SnapsToDevicePixels="True"
    SystemBackdropType="Mica"
    UseLayoutRounding="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="MainWindowHeader" Grid.Row="0" Margin="0,0,0,16">
            <TextBlock
                fluence:TextBlockExtensions.Typography="Title"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="Fluence.Wpf from PowerShell"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,8,0,0"
                fluence:TextBlockExtensions.Typography="Body"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Explore Fluent controls, switch themes, and try accent colors in a window loaded from XAML."
                TextWrapping="Wrap" />
        </StackPanel>

        <fluence:SmoothScrollViewer
            x:Name="MainScrollViewer"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <fluence:Card Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,12"
                            fluence:TextBlockExtensions.Typography="BodyStrong"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="Theme and accent" />

                        <WrapPanel Margin="0,0,0,8">
                            <StackPanel Width="220" Margin="0,0,16,8">
                                <TextBlock
                                    Margin="0,0,0,8"
                                    fluence:TextBlockExtensions.Typography="Body"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="Theme" />
                                <fluence:ComboBox x:Name="ThemeComboBox" SelectedIndex="0" AutomationProperties.Name="Theme">
                                    <ComboBoxItem Content="Use system setting" Tag="Auto" />
                                    <ComboBoxItem Content="Light" Tag="Light" />
                                    <ComboBoxItem Content="Dark" Tag="Dark" />
                                    <ComboBoxItem Content="High contrast" Tag="HighContrast" />
                                </fluence:ComboBox>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,8" VerticalAlignment="Bottom" Orientation="Horizontal">
                                <fluence:Button
                                    x:Name="AccentButton"
                                    Margin="0,0,8,0"
                                    Appearance="Accent"
                                    Content="Cycle accent" />
                                <fluence:Button x:Name="SystemAccentButton" Content="Use system accent" />
                            </StackPanel>
                        </WrapPanel>

                        <fluence:InfoBar
                            x:Name="StatusInfoBar"
                            Title="Ready"
                            IsClosable="False"
                            IsOpen="True"
                            Message="Theme watcher is enabled after the window is created."
                            Severity="Informational" />
                    </StackPanel>
                </fluence:Card>

                <fluence:Card Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,12"
                            fluence:TextBlockExtensions.Typography="BodyStrong"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="Controls" />

                        <WrapPanel>
                            <fluence:Button
                                x:Name="PrimaryActionButton"
                                Margin="0,0,8,8"
                                Appearance="Accent"
                                Content="Primary action" />
                            <fluence:Button Margin="0,0,8,8" Content="Standard button" />
                            <fluence:ToggleSwitch
                                Margin="0,0,16,8"
                                Content="Notifications"
                                IsChecked="True"
                                OffContent="Off"
                                OnContent="On" />
                            <fluence:CheckBox
                                Margin="0,0,16,8"
                                Content="Remember choice"
                                IsChecked="True" />
                            <fluence:RadioButton
                                Margin="0,0,16,8"
                                Content="Option A"
                                GroupName="DemoOptions"
                                IsChecked="True" />
                            <fluence:RadioButton
                                Margin="0,0,16,8"
                                Content="Option B"
                                GroupName="DemoOptions" />
                        </WrapPanel>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock
                                    Margin="0,0,0,8"
                                    fluence:TextBlockExtensions.Typography="Body"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="Message" />
                                <fluence:TextBox
                                    AutomationProperties.Name="Message"
                                    PlaceholderText="Type a message"
                                    Text="Loaded from MainWindow.xaml" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock
                                    Margin="0,0,0,8"
                                    fluence:TextBlockExtensions.Typography="Body"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="Count" />
                                <fluence:NumberBox
                                    AutomationProperties.Name="Count"
                                    Maximum="10"
                                    Minimum="0"
                                    SpinButtonPlacementMode="Compact"
                                    Value="3" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </fluence:Card>

                <fluence:Card>
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,12"
                            fluence:TextBlockExtensions.Typography="BodyStrong"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="Progress" />
                        <fluence:ProgressBar Margin="0,0,0,16" ProgressMode="Indeterminate" AutomationProperties.Name="Overall progress" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <fluence:ProgressRing
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                IsIndeterminate="True"
                                AutomationProperties.Name="Current activity" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                fluence:TextBlockExtensions.Typography="Body"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Indeterminate progress ring"
                                TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </fluence:Card>
            </StackPanel>
        </fluence:SmoothScrollViewer>

        <Grid x:Name="MainWindowFooter" Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                fluence:TextBlockExtensions.Typography="Caption"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Close the window to return to the console."
                TextWrapping="Wrap" />
            <fluence:Button x:Name="CloseButton" Grid.Column="1" Content="Close" MinWidth="120" HorizontalAlignment="Right" IsCancel="True" />
        </Grid>
    </Grid>
</fluence:FluenceWindow>
