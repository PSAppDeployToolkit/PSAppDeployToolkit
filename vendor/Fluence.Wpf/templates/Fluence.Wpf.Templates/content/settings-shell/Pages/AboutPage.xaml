<UserControl
    x:Class="FluenceStarterApp.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluence="http://schemas.fluencewpf.com"
    Background="{DynamicResource ApplicationBackgroundBrush}">
    <fluence:SmoothScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" Margin="28,16,28,24" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="About" />
            <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource SettingsPageDescriptionStyle}"
                Text="A small settings shell built with Fluence.Wpf controls for your own app." />

            <StackPanel Margin="0,24,0,0">
                <TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="This sample" />
                <Border Margin="0,8,0,0" Style="{StaticResource SettingRowCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <fluence:FontIcon Style="{StaticResource SettingRowIconStyle}" Glyph="&#xE946;" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingRowTitleStyle}" Text="FluenceStarterApp" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource SettingRowDescriptionStyle}" Text="A local example. Replace these rows with settings for your app." />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Margin="0,5,0,0" Style="{StaticResource SettingRowCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <fluence:FontIcon Style="{StaticResource SettingRowIconStyle}" Glyph="&#xE946;" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingRowTitleStyle}" Text="Sample state" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource SettingRowDescriptionStyle}" Text="Confirm that these examples do not store settings outside this app." />
                        </StackPanel>
                        <fluence:Button
                            Grid.Column="4"
                            MinWidth="112"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Explain sample state"
                            Click="ExplainState_Click"
                            Content="Explain" />
                    </Grid>
                </Border>
            </StackPanel>
            <Border Margin="0,24,0,24" Style="{StaticResource SettingRowCardStyle}">
                <TextBlock
                    x:Name="AboutStatus"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource SettingRowDescriptionStyle}"
                    Text="The example values reset when you restart the app." />
            </Border>
        </StackPanel>
    </fluence:SmoothScrollViewer>
</UserControl>
