<UserControl
    x:Class="FluenceStarterApp.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluence="http://schemas.fluencewpf.com"
    Background="{DynamicResource ApplicationBackgroundBrush}">
    <fluence:SmoothScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" Margin="28,16,28,24" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="General" />
            <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource SettingsPageDescriptionStyle}"
                Text="Set up how this sample app starts and responds. These choices stay in this window only." />

            <StackPanel Margin="0,24,0,0">
                <TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="Preferences" />
                <Border Margin="0,8,0,0" Style="{StaticResource SettingRowCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <fluence:FontIcon Style="{StaticResource SettingRowIconStyle}" Glyph="&#xE80F;" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingRowTitleStyle}" Text="Open to your workspace" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource SettingRowDescriptionStyle}" Text="Choose the starting view for this sample session." />
                        </StackPanel>
                        <fluence:ToggleSwitch
                            x:Name="WorkspaceToggle"
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Open to your workspace"
                            Click="PreferenceChanged"
                            IsChecked="True" />
                    </Grid>
                </Border>
                <Border Margin="0,5,0,0" Style="{StaticResource SettingRowCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <fluence:FontIcon Style="{StaticResource SettingRowIconStyle}" Glyph="&#xE8D2;" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingRowTitleStyle}" Text="Reading density" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource SettingRowDescriptionStyle}" Text="Choose how much content the app would show at once." />
                        </StackPanel>
                        <fluence:ComboBox
                            x:Name="DensityChoice"
                            Grid.Column="4"
                            Width="154"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Reading density"
                            DisplayMemberPath="Name"
                            SelectionChanged="DensityChoice_SelectionChanged" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Margin="0,24,0,0">
                <TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="Session" />
                <Border Margin="0,8,0,0" Style="{StaticResource SettingRowCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <fluence:FontIcon Style="{StaticResource SettingRowIconStyle}" Glyph="&#xE8A5;" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingRowTitleStyle}" Text="Review sample choices" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource SettingRowDescriptionStyle}" Text="Show the values currently held in this page." />
                        </StackPanel>
                        <fluence:Button
                            Grid.Column="4"
                            MinWidth="112"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Review general choices"
                            Click="ReviewChoices_Click"
                            Content="Review" />
                    </Grid>
                </Border>
            </StackPanel>
            <Border Margin="0,24,0,24" Style="{StaticResource SettingRowCardStyle}">
                <TextBlock
                    x:Name="GeneralStatus"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource SettingRowDescriptionStyle}"
                    Text="Workspace opens first. Reading density: Comfortable." />
            </Border>
        </StackPanel>
    </fluence:SmoothScrollViewer>
</UserControl>
