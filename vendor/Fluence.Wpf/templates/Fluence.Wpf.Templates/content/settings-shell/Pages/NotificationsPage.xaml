<UserControl
    x:Class="FluenceStarterApp.Pages.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluence="http://schemas.fluencewpf.com"
    Background="{DynamicResource ApplicationBackgroundBrush}">
    <fluence:SmoothScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" Margin="28,16,28,24" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="Notifications" />
            <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource SettingsPageDescriptionStyle}"
                Text="Preview notification preferences for this sample app. No Windows notification settings are changed." />

            <StackPanel Margin="0,24,0,0">
                <TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="Delivery" />
                <Border Margin="0,8,0,0" Style="{StaticResource SettingRowCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <fluence:FontIcon Style="{StaticResource SettingRowIconStyle}" Glyph="&#xE7F4;" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingRowTitleStyle}" Text="Activity alerts" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource SettingRowDescriptionStyle}" Text="Include new activity in the sample summary." />
                        </StackPanel>
                        <fluence:ToggleSwitch
                            x:Name="ActivityToggle"
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Activity alerts"
                            Click="NotificationPreferenceChanged"
                            IsChecked="True" />
                    </Grid>
                </Border>
                <Border Margin="0,5,0,0" Style="{StaticResource SettingRowCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <fluence:FontIcon Style="{StaticResource SettingRowIconStyle}" Glyph="&#xE916;" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingRowTitleStyle}" Text="Quiet summary" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource SettingRowDescriptionStyle}" Text="Show a shorter sample status message." />
                        </StackPanel>
                        <fluence:ToggleSwitch
                            x:Name="QuietToggle"
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Quiet summary"
                            Click="NotificationPreferenceChanged" />
                    </Grid>
                </Border>
            </StackPanel>
            <StackPanel Margin="0,24,0,0">
                <TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="Preview" />
                <Border Margin="0,8,0,0" Style="{StaticResource SettingRowCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <fluence:FontIcon Style="{StaticResource SettingRowIconStyle}" Glyph="&#xE8A5;" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingRowTitleStyle}" Text="Update preview" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource SettingRowDescriptionStyle}" Text="Read the current in-memory preference values." />
                        </StackPanel>
                        <fluence:Button
                            Grid.Column="4"
                            MinWidth="112"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Update notification preview"
                            Click="UpdatePreview_Click"
                            Content="Update" />
                    </Grid>
                </Border>
            </StackPanel>
            <Border Margin="0,24,0,24" Style="{StaticResource SettingRowCardStyle}">
                <TextBlock
                    x:Name="NotificationStatus"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource SettingRowDescriptionStyle}"
                    Text="Activity alerts are on. Quiet summary is off." />
            </Border>
        </StackPanel>
    </fluence:SmoothScrollViewer>
</UserControl>
