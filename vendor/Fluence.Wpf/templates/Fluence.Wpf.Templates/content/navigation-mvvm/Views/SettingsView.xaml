<UserControl x:Class="FluenceStarterApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluence="http://schemas.fluencewpf.com">
    <Grid Margin="32">
        <StackPanel MaxWidth="720"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
            <TextBlock FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="Settings" />
            <TextBlock Margin="0,8,0,24"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="These example preferences live in memory for this app session."
                       TextWrapping="Wrap" />

            <Border Padding="20"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="Helpful tips preference" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Example app-local preference held for this session."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <fluence:ToggleSwitch Grid.Column="1"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding ShowHelpfulTips, Mode=TwoWay}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="Compact navigation preference" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Collapse the navigation pane to an icon-only rail."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <fluence:ToggleSwitch Grid.Column="1"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding UseCompactNavigation, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
