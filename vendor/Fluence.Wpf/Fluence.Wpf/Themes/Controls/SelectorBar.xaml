<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Fluence.Wpf.Controls">

    <!--
        Fluent Design SelectorBar style.
        Authority: WinUI 3 SelectorBar.xaml + SelectorBar_themeresources.xaml. The bar is a
        transparent, left-aligned strip with SelectorBarPadding 0,4 whose items lay out
        horizontally (WinUI hosts them in an ItemsView with a horizontal StackLayout; the WPF
        port uses a horizontal StackPanel items host, since WPF has no ItemsView).
        Item metrics are WinUI-literal: SelectorBarItemPadding 12,10,12,7, SelectorBarItemSpacing
        8 between the icon and the label, SelectorBarItemIconScale 0.8 on the icon, and a pill of
        SelectorBarItemPillWidth 4 by SelectorBarItemPillHeight 3 with RadiusX 0.5 / RadiusY 1,
        centred under the item and scaled to four times its width while selected
        (SelectorBarItem.cs plays that reveal).
        The foreground ramp is the WinUI one: rest TextFillColorPrimaryBrush
        (SelectorBarItemForeground), hover TextFillColorSecondaryBrush, selected back to
        TextFillColorPrimaryBrush, disabled TextFillColorDisabledBrush. WinUI also has a pressed
        step (SelectorBarItemForegroundPressed, TextFillColorTertiaryBrush), which this port does
        not draw: a WPF item container has no IsPressed to trigger on, the same gap the other
        item containers carry (docs/winui-parity.md section 8). Every SelectorBarItem background
        in WinUI's own theme dictionary is SystemControlTransparentBrush in all states, so the
        item paints no plate at all and only the label colour and the pill move.
        The pill is NavigationViewSelectionIndicatorForeground, the library's shared selection
        accent (WinUI's SelectorBarItemPillFill is AccentFillColorDefaultBrush, the same colour in
        Light and Dark), and AccentFillColorDisabledBrush while disabled
        (SelectorBarItemDisabledPillFill). The shared key is what carries a high contrast override
        to the live SystemColors.HighlightColor, matching WinUI's SystemColorHighlightColor
        mapping; AccentFillColorDefaultBrush has no such override.
    -->

    <Style TargetType="{x:Type controls:SelectorBarItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="12,10,12,7" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SelectorBarItem}">
                    <Grid
                        x:Name="ContainerRoot"
                        Background="{TemplateBinding Background}"
                        UseLayoutRounding="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel
                            x:Name="ContentHost"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Orientation="Horizontal">
                            <!--  SelectorBarItemIconVisualMargin -2,0 (negative on both sides) plus SelectorBarItemSpacing 8: net 6px between the icon and the label.  -->
                            <ContentPresenter
                                x:Name="IconPresenter"
                                Margin="-2,0,6,0"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Icon}"
                                RenderTransformOrigin="0.5,0.5"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.RenderTransform>
                                    <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                            <TextBlock
                                x:Name="TextVisual"
                                VerticalAlignment="Center"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                FontWeight="{TemplateBinding FontWeight}"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{TemplateBinding Text}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Rectangle
                            x:Name="PART_SelectionVisual"
                            Grid.Row="1"
                            Width="4"
                            Height="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Fill="{DynamicResource NavigationViewSelectionIndicatorForeground}"
                            IsHitTestVisible="False"
                            Opacity="0"
                            RadiusX="0.5"
                            RadiusY="1"
                            RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform x:Name="PART_SelectionVisualScale" ScaleX="1" ScaleY="1" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  WinUI SelectorBarItem::UpdatePartsVisibility collapses each empty part, and the whole host when the item carries neither, so the padding box does not hold space for nothing.  -->
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter TargetName="TextVisual" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="TextVisual" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Icon" Value="{x:Null}" />
                                <Condition Property="Text" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ContentHost" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Icon" Value="{x:Null}" />
                                <Condition Property="Text" Value="" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ContentHost" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter TargetName="PART_SelectionVisual" Property="Fill" Value="{DynamicResource AccentFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:SelectorBar}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel IsItemsHost="True" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SelectorBar}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ItemsPresenter Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
