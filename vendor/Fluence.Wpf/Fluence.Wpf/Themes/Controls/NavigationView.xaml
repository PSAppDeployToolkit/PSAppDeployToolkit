    </ControlTemplate>

    <!--  Top pane template  -->
    <ControlTemplate x:Key="NavigationViewTopPaneTemplate" TargetType="{x:Type controls:NavigationView}">
        <!--
            No top border or top corner rounding: in Top mode the nav strip sits directly
            under the window title bar, so a top stroke would draw a seam between the title
            bar and the navigation list. The sides and bottom keep the 1px outline and the
            bottom corners keep the 8px overlay radius.
        -->
        <Border
            Background="{TemplateBinding Background}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,1,1"
            ClipToBounds="True"
            CornerRadius="0,0,8,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--
                    Pane background: WinUI 3 NavigationView.xaml paints TopNavArea with
                    NavigationViewTopPaneBackground unconditionally, and that token is
                    SolidBackgroundFillColorTransparent in Light and Dark.
                -->
                <Border
                    x:Name="PaneHeaderBorder"
                    Grid.Row="0"
                    Padding="4,0,8,0"
                    Background="{DynamicResource SolidBackgroundFillColorTransparentBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="PART_BackButton"
                            Grid.Column="0"
                            Margin="24,0,4,0"
                            Padding="6"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Back"
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="True"
                            Template="{StaticResource NavigationViewBackButtonTemplate}"
                            Visibility="Collapsed">
                            <controls:FontIcon
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Glyph="&#xE72B;"
                                IconFontSize="20" />
                        </Button>
                        <ContentPresenter
                            Grid.Column="1"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding PaneHeader}" />
                        <Grid
                            x:Name="PART_TopItemsHost"
                            Grid.Column="2"
                            VerticalAlignment="Stretch"
                            ClipToBounds="True">
                            <ItemsPresenter VerticalAlignment="Center" />
                            <controls:Button
                                x:Name="PART_TopOverflowButton"
                                Width="40"
                                Height="36"
                                MinWidth="40"
                                MinHeight="36"
                                Margin="0"
                                Padding="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Panel.ZIndex="2"
                                Appearance="{x:Static uicore:ControlAppearance.Subtle}"
                                Visibility="Collapsed">
                                <controls:FontIcon
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Glyph="&#xE712;"
                                    IconFontSize="16" />
                            </controls:Button>
                            <Border
                                x:Name="PART_SelectionIndicator"
                                Width="16"
                                Height="3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource NavigationViewSelectionIndicatorForeground}"
                                CornerRadius="1.5"
                                IsHitTestVisible="False"
                                Opacity="0"
                                RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform />
                                        <TranslateTransform />
                                    </TransformGroup>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <StackPanel
                            Grid.Column="3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Orientation="Horizontal">
                            <!--  FooterMenuItems: right-docked, selectable footer entries. Not part of the main top overflow.  -->
                            <Grid VerticalAlignment="Stretch">
                                <ItemsControl
                                    x:Name="PART_FooterItemsHost"
                                    VerticalAlignment="Center"
                                    controls:NavigationView.IsFooterItem="True"
                                    Focusable="False"
                                    ItemsSource="{Binding FooterMenuItems, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Focusable="False" Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <!--  Canvas reports zero desired size, so the indicator overlays the footer items without widening column 3 (which would steal width from the top overflow calculation). The Canvas fills the footer Grid cell at its origin, so canvas-space coordinates equal footer-Grid coordinates; CalculateIndicatorPosition transforms the selected item into the footer Grid (the indicator host) to centre the indicator under it.  -->
                                <Canvas>
                                    <Border
                                        x:Name="PART_FooterSelectionIndicator"
                                        Canvas.Left="0"
                                        Canvas.Bottom="0"
                                        Width="16"
                                        Height="3"
                                        Background="{DynamicResource NavigationViewSelectionIndicatorForeground}"
                                        CornerRadius="1.5"
                                        IsHitTestVisible="False"
                                        Opacity="0"
                                        RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform />
                                                <TranslateTransform />
                                            </TransformGroup>
                                        </Border.RenderTransform>
                                    </Border>
                                </Canvas>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding PaneFooter}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Background="{TemplateBinding ContentBackground}">
                    <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" />
                </Border>
            </Grid>
            <!--  WI-3 B15: BackButtonStates VSM group - WinUI NavigationView canonical  -->
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="BackButtonStates">
                    <VisualState x:Name="BackButtonVisible">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_BackButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="BackButtonCollapsed">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_BackButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Border>
        <ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsBackButtonVisible" Value="True" />
                    <Condition Property="IsBackEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_BackButton" Property="Visibility" Value="Visible" />
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  NavigationView default style  -->
    <Style TargetType="{x:Type controls:NavigationView}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ContentBackground" Value="{DynamicResource NavigationViewContentBackgroundBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource FluentFontFamily}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Focusable="False" Orientation="Vertical" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template" Value="{StaticResource NavigationViewLeftPaneTemplate}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="PaneDisplayMode" Value="{x:Static uicore:NavigationViewPaneDisplayMode.Top}">
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <StackPanel Focusable="False" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template" Value="{StaticResource NavigationViewTopPaneTemplate}" />
            </Trigger>
            <Trigger Property="PaneDisplayMode" Value="{x:Static uicore:NavigationViewPaneDisplayMode.LeftCompact}">
                <Setter Property="Template" Value="{StaticResource NavigationViewLeftCompactPaneTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
