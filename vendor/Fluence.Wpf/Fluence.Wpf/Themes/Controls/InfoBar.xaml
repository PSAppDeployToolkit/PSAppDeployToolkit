<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Fluence.Wpf.Controls"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="clr-namespace:Fluence.Wpf">

    <Style x:Key="InfoBarCloseButtonFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>
                        <Border
                            Margin="-3"
                            BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}"
                            BorderThickness="2"
                            CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border
                            Margin="-2"
                            BorderBrush="{DynamicResource FocusStrokeColorInnerBrush}"
                            BorderThickness="1"
                            CornerRadius="3" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  WinUI InfoBarCloseButtonSize 38 and InfoBarCloseButtonGlyphSize 16 (InfoBar_themeresources.xaml:67-68). The button was a 28 dip square carrying a 12 dip glyph, which read as a smaller affordance than the 14 dip text beside it.  -->
    <sys:Double x:Key="InfoBarCloseButtonSize">38</sys:Double>
    <sys:Double x:Key="InfoBarCloseButtonGlyphSize">16</sys:Double>

    <!--
        Subtle plate for the close button. WinUI InfoBar.xaml swaps the close button's
        brushes to the AppBarButton set: transparent rest plate, SubtleFillColorSecondary
        hover / SubtleFillColorTertiary press, primary-to-secondary text foreground, no
        border, ControlCornerRadius rounding (see TeachingTip.xaml / PipsPager.xaml for
        the same plate pattern). The template is required: a stock Button without one
        falls back to the OS default chrome, whose internal triggers paint square
        corners and legacy hover colors regardless of the Background property.
    -->
    <Style x:Key="InfoBarCloseButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource InfoBarCloseButtonFocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Height" Value="{StaticResource InfoBarCloseButtonSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="ButtonPlate"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonPlate" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonPlate" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Width" Value="{StaticResource InfoBarCloseButtonSize}" />
    </Style>

    <Style TargetType="{x:Type controls:InfoBar}">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <!--  WinUI sets the bar's radius from the theme token rather than a literal (InfoBar.xaml:11), so an application that retunes ControlCornerRadius reaches the InfoBar too. The DP's own default stays 4 for a bar built in code with no theme applied.  -->
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource FluentFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Opacity" Value="0" />
        <!--  WinUI InfoBarContentRootPadding = 16,0,0,0 (InfoBar_themeresources.xaml:75); the vertical inset lives on the icon margin and the panel's orientation padding instead, so a single line bar is 48 dip tall.  -->
        <Setter Property="Padding" Value="16,0,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:InfoBar}">
                    <Border
                        x:Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        ClipToBounds="False"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <!--  Content area. WinUI has no separate indicator-bar column (InfoBar.xaml upstream); the severity read comes entirely from the icon and background. The inset is WinUI's InfoBarContentRootPadding 16,0,0,0 over InfoBarMinHeight 48 (InfoBar_themeresources.xaml:66,75): every other edge inset is carried by the icon margin, the panel's own orientation padding and the close button's margin, so the bar can collapse to one 48 dip line.  -->
                        <Grid MinHeight="48" Margin="{TemplateBinding Padding}">
                            <!--  Icon, then title / message / action, then the close button: WinUI's own three columns (InfoBar.xaml:95-101).  -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <!--  Banner row: icon, title, message, action and close.  -->
                                <RowDefinition Height="Auto" />
                                <!--  Free-form Content, under the banner, as WinUI's ContentArea sits (InfoBar.xaml:126).  -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Icon area  -->
                            <!--  WinUI top-aligns the icon and insets it with InfoBarIconMargin 0,16,14,16 (InfoBar.xaml:108-110, InfoBar_themeresources.xaml:76), so the glyph stays beside the title rather than drifting to the middle of a tall, wrapped bar.  -->
                            <Grid
                                x:Name="IconArea"
                                Grid.Column="0"
                                Margin="0,16,14,16"
                                VerticalAlignment="Top">
                                <!--
                                    WinUI parity: two-layer severity glyph (InfoBar.xaml:108-109 upstream).
                                    IconBackground paints the filled-circle glyph (F136) in the severity
                                    brush; StandardIcon draws the specific per-severity glyph on top in the
                                    fixed TextFillColorInverseBrush so it reads against the colored circle
                                    in both themes.
                                -->
                                <TextBlock
                                    x:Name="IconBackground"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    FontSize="16"
                                    Foreground="{DynamicResource SystemFillColorAttentionBrush}"
                                    Text="&#xF136;"
                                    Visibility="Collapsed" />
                                <TextBlock
                                    x:Name="StandardIcon"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    FontSize="16"
                                    Foreground="{DynamicResource TextFillColorInverseBrush}"
                                    Text="&#xF13F;"
                                    Visibility="Collapsed" />
                                <!--  Custom icon override (shown when Icon DP is set). WinUI hosts a custom icon in a Viewbox capped at InfoBarIconFontSize on both axes (InfoBar.xaml:111), so an oversized icon scales down instead of inflating the icon column and pushing the whole bar taller.  -->
                                <Viewbox
                                    x:Name="CustomIconBox"
                                    MaxWidth="16"
                                    MaxHeight="16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Stretch="Uniform">
                                <ContentPresenter
                                    x:Name="CustomIconPresenter"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Icon}"
                                    TextElement.Foreground="{TemplateBinding Foreground}">
                                    <ContentPresenter.Resources>
                                        <!--  Custom icon follows the InfoBar title text (SplitButton precedent); the default severity icon above stays semantic. A consumer's local Foreground still wins.  -->
                                        <Style TargetType="{x:Type controls:FontIcon}">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:InfoBar}}}" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                                </Viewbox>
                            </Grid>

                            <!--
                                Title, message and action share one panel that picks its own
                                orientation, as WinUI's InfoBarPanel does (InfoBar.xaml:112-125):
                                one line while all three fit, stacked when they do not. The two
                                margins per child are WinUI's own
                                (InfoBar_themeresources.xaml:79-86), because the gap between a
                                title and a message side by side is not the gap between them
                                stacked.
                            -->
                            <controls:InfoBarPanel
                                x:Name="PART_BannerPanel"
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,0,16,0"
                                HorizontalOrientationPadding="0"
                                VerticalOrientationPadding="0,14,0,18">
                                <TextBlock
                                    x:Name="TitleTextBlock"
                                    controls:InfoBarPanel.HorizontalOrientationMargin="0,14,0,0"
                                    controls:InfoBarPanel.VerticalOrientationMargin="0,14,0,0"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    FontWeight="SemiBold"
                                    Foreground="{TemplateBinding Foreground}"
                                    Text="{TemplateBinding Title}"
                                    TextWrapping="Wrap" />
                                <!--  WinUI parity: InfoBarMessageForeground (InfoBar_themeresources.xaml:18) is TextFillColorPrimaryBrush, following the control's own Foreground like the title, not a hardcoded secondary tone.  -->
                                <TextBlock
                                    x:Name="MessageTextBlock"
                                    controls:InfoBarPanel.HorizontalOrientationMargin="12,14,0,0"
                                    controls:InfoBarPanel.VerticalOrientationMargin="0,4,0,0"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Foreground="{TemplateBinding Foreground}"
                                    Text="{TemplateBinding Message}"
                                    TextWrapping="Wrap" />
                                <!--  Action button slot  -->
                                <ContentPresenter
                                    x:Name="ActionPresenter"
                                    controls:InfoBarPanel.HorizontalOrientationMargin="16,8,0,0"
                                    controls:InfoBarPanel.VerticalOrientationMargin="0,12,0,0"
                                    VerticalAlignment="Top"
                                    Content="{TemplateBinding ActionButton}">
                                    <ContentPresenter.Resources>
                                        <!--  A hyperlink in the action slot pulls its own padding back, as WinUI's scoped style does (InfoBar.xaml:116-123, InfoBarHyperlinkButtonMargin -12,0,0,0), so the link text lines up with the message rather than sitting a button's padding further right. The foreground is left to the control: InfoBarHyperlinkButtonForeground is AccentTextFillColorPrimaryBrush, which is what HyperlinkButton already paints.  -->
                                        <Style BasedOn="{StaticResource {x:Type controls:HyperlinkButton}}" TargetType="{x:Type controls:HyperlinkButton}">
                                            <Setter Property="Margin" Value="-12,0,0,0" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </controls:InfoBarPanel>

                            <!--  Free-form content. InfoBar is a ContentControl, so this is its XAML content property, and without a presenter for it anything a consumer nests in the bar compiled and rendered nothing. WinUI names the same presenter ContentArea and keeps it in the second row (InfoBar.xaml:126), promoted to the first when the bar carries neither title nor message (its NoBannerContent state, InfoBar.xaml:84-91).  -->
                            <ContentPresenter
                                x:Name="ContentArea"
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,8,8,0"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />

                            <!--  Close button  -->
                            <!--  WinUI's InfoBarCloseButtonStyle is VerticalAlignment Top with Margin 5 (InfoBar_themeresources.xaml:88-94), so the close button sits at the top right of a tall bar rather than halfway down it.  -->
                            <Button
                                x:Name="PART_CloseButton"
                                Grid.Column="2"
                                Margin="5"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="Close"
                                Style="{StaticResource InfoBarCloseButtonStyle}"
                                ToolTip="Close">
                                <controls:FontIcon
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                    Glyph="&#xE711;"
                                    IconFontSize="{StaticResource InfoBarCloseButtonGlyphSize}"
                                    IsHitTestVisible="False" />
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  IsOpen: visible state + open/close animation  -->
                        <Trigger Property="IsOpen" Value="True">
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <!--  ControlFastAnimationDuration (167 ms) open fade  -->
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.167"
                                                Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!--  ControlFastAnimationDuration (167 ms) close fade  -->
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.167"
                                                Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.167" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!--  IsClosable hidden  -->
                        <Trigger Property="IsClosable" Value="False">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!--  IsIconVisible hidden  -->
                        <Trigger Property="IsIconVisible" Value="False">
                            <Setter TargetName="IconArea" Property="Margin" Value="0" />
                            <Setter TargetName="IconArea" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!--  Custom icon override: when Icon is null show the two-layer severity glyph, otherwise show the custom icon  -->
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconBackground" Property="Visibility" Value="Visible" />
                            <Setter TargetName="StandardIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CustomIconPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!--  Title empty → collapse  -->
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="TitleTextBlock" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="TitleTextBlock" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!--  Message empty → collapse  -->
                        <Trigger Property="Message" Value="{x:Null}">
                            <Setter TargetName="MessageTextBlock" Property="Margin" Value="0" />
                            <Setter TargetName="MessageTextBlock" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Message" Value="">
                            <Setter TargetName="MessageTextBlock" Property="Margin" Value="0" />
                            <Setter TargetName="MessageTextBlock" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!--  Content empty → collapse, so the second row costs nothing.  -->
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="ContentArea" Property="Margin" Value="0" />
                            <Setter TargetName="ContentArea" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!--  No banner text: the content takes the banner row itself, which is WinUI's NoBannerContent state.  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Title" Value="{x:Null}" />
                                <Condition Property="Message" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ContentArea" Property="Grid.Row" Value="0" />
                            <Setter TargetName="ContentArea" Property="Margin" Value="0,0,8,0" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Title" Value="" />
                                <Condition Property="Message" Value="" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ContentArea" Property="Grid.Row" Value="0" />
                            <Setter TargetName="ContentArea" Property="Margin" Value="0,0,8,0" />
                        </MultiTrigger>

                        <!--  ActionButton empty → collapse  -->
                        <Trigger Property="ActionButton" Value="{x:Null}">
                            <Setter TargetName="ActionPresenter" Property="Margin" Value="0" />
                            <Setter TargetName="ActionPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!--  Severity: Informational (default)  -->
                        <Trigger Property="Severity" Value="{x:Static ui:InfoBarSeverity.Informational}">
                            <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
                            <Setter TargetName="IconBackground" Property="Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                            <Setter TargetName="StandardIcon" Property="Text" Value="&#xF13F;" />
                        </Trigger>

                        <!--  Severity: Success  -->
                        <Trigger Property="Severity" Value="{x:Static ui:InfoBarSeverity.Success}">
                            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                            <Setter TargetName="IconBackground" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                            <Setter TargetName="StandardIcon" Property="Text" Value="&#xF13E;" />
                        </Trigger>

                        <!--  Severity: Warning  -->
                        <Trigger Property="Severity" Value="{x:Static ui:InfoBarSeverity.Warning}">
                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                            <Setter TargetName="IconBackground" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            <Setter TargetName="StandardIcon" Property="Text" Value="&#xF13C;" />
                        </Trigger>

                        <!--  Severity: Error  -->
                        <Trigger Property="Severity" Value="{x:Static ui:InfoBarSeverity.Error}">
                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                            <Setter TargetName="IconBackground" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            <Setter TargetName="StandardIcon" Property="Text" Value="&#xF13D;" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

</ResourceDictionary>
