<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Fluence.Wpf.Controls">

    <!--
        Fluent Design BreadcrumbBar style.
        Authority: WinUI 3 BreadcrumbBar.xaml + BreadcrumbBar_themeresources.xaml (two-column
        crumb layout of content followed by a chevron separator; chevron font size 12 with
        2,0 padding; item font size 14 at Normal weight; ControlCornerRadius on the click
        plate; transparent bar background and border).
        Crumb foreground follows the WinUI BreadcrumbBar ramp: rest TextFillColorPrimaryBrush
        (BreadcrumbBarNormalForegroundBrush), hover TextFillColorSecondaryBrush
        (BreadcrumbBarHoverForegroundBrush), press TextFillColorTertiaryBrush
        (BreadcrumbBarPressedForegroundBrush). WinUI paints no hover or pressed plate on a crumb
        (BreadcrumbBar.xaml:197, :211 upstream both set PART_ContentPresenter.Background back to
        the same transparent BreadcrumbBarBackgroundBrush used at rest), so only the foreground
        changes; there is no subtle fill here. The current (last) crumb hides its chevron and
        renders TextFillColorPrimaryBrush at rest (BreadcrumbBarCurrentNormalForegroundBrush),
        TextFillColorSecondaryBrush on hover, and TextFillColorTertiaryBrush pressed
        (BreadcrumbBarCurrentHoverForegroundBrush / CurrentPressedForegroundBrush,
        BreadcrumbBar_themeresources.xaml:15-16); its SemiBold weight is a deliberate owner
        deviation (WinUI uses BreadcrumbBarItemFontWeight Normal). WinUI's 1,3 content padding is
        widened to 4,3 to match the rest of this control's hit-target sizing.
        The chevron separator is the Fluence FontIcon with the WinUI
        BreadcrumbBarChevronLeftToRight glyph (E974) in TextFillColorPrimaryBrush
        (BreadcrumbBarNormalForegroundBrush), hit-test invisible so only the content plate is
        the click target.
        WinUI's ellipsis overflow collapse is a deliberate v1 omission (see BreadcrumbBar.cs);
        the strip extends to its natural width and clips when constrained.
    -->

    <Style TargetType="{x:Type controls:BreadcrumbBarItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="FontFamily" Value="{DynamicResource FluentFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:BreadcrumbBarItem}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="ContentPlate"
                            Grid.Column="0"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"
                                TextElement.FontFamily="{TemplateBinding FontFamily}"
                                TextElement.FontSize="{TemplateBinding FontSize}"
                                TextElement.FontWeight="{TemplateBinding FontWeight}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <controls:FontIcon
                            x:Name="ChevronIcon"
                            Grid.Column="1"
                            Margin="2,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Glyph="&#xE974;"
                            IconFontSize="12"
                            IsHitTestVisible="False" />
                    </Grid>
                    <!--  Press scale storyboards mirror Button.xaml (0.98 over 100ms on the 0,0,0,1 ControlFastOutSlowIn spline).  -->
                    <ControlTemplate.Resources>
                        <Storyboard x:Key="PressedScaleStoryboard">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX">
                                <SplineDoubleKeyFrame
                                    KeySpline="0,0,0,1"
                                    KeyTime="0:0:0.1"
                                    Value="0.98" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY">
                                <SplineDoubleKeyFrame
                                    KeySpline="0,0,0,1"
                                    KeyTime="0:0:0.1"
                                    Value="0.98" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                        <Storyboard x:Key="ReleasedScaleStoryboard">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX">
                                <SplineDoubleKeyFrame
                                    KeySpline="0,0,0,1"
                                    KeyTime="0:0:0.1"
                                    Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY">
                                <SplineDoubleKeyFrame
                                    KeySpline="0,0,0,1"
                                    KeyTime="0:0:0.1"
                                    Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </ControlTemplate.Resources>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsLastItem" Value="True">
                            <Setter TargetName="ChevronIcon" Property="Visibility" Value="Collapsed" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsLastItem" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsLastItem" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource PressedScaleStoryboard}" />
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource ReleasedScaleStoryboard}" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <!--
                            The current (last) crumb also has hover/pressed foreground states
                            (WinUI CurrentPointerOver / CurrentPressed visual states,
                            BreadcrumbBar_themeresources.xaml:15-16), distinct from its SemiBold
                            rest color set above.
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsLastItem" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsLastItem" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource PressedScaleStoryboard}" />
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource ReleasedScaleStoryboard}" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter TargetName="ChevronIcon" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="{x:Type controls:BreadcrumbBar}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource FluentFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <!--
            IsTabStop=False: the bar itself must not be a tab stop. Keyboard focus belongs to
            the individual BreadcrumbBarItem crumbs. See DatePicker.xaml for the same pattern.
        -->
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Focusable="False" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:BreadcrumbBar}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
