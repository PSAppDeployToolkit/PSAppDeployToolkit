<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Fluence.Wpf.Controls">

    <!--
        Fluent Design PipsPager style.
        Authority: WinUI 3 PipsPager.xaml + PipsPager_themeresources.xaml (a run of round pip
        dots inside fixed square touch targets, selected pip larger, optional previous/next
        chevron buttons with the subtle fill states).
        Pips are neutral per PipsPagerSelectionIndicatorForeground*: dot 4px at rest in
        ControlStrongFillColorDefaultBrush, TextFillColorSecondaryBrush on hover and pressed,
        ControlStrongFillColorDefaultBrush selected (ControlStrongFillColorDisabledBrush when
        disabled); the size changes animate over the ControlFasterAnimationDuration on the
        ControlFastOutSlowIn spline (ToggleSwitch.xaml knob-morph precedent).
        The real WinUI pip-size ramp is 4 rest, 6 hover, 6 selected, 4 pressed (a pointer-over
        pip jumps straight to the selected size via PipsPagerSelectedGlyphFontSize, and even a
        selected pip shrinks back to the normal 4px size while pressed, since
        PipsPagerSelectedPipButtonStyle inherits the same CommonStates group as the normal pip
        style). This port keeps rest=4 and selected=6 but grows hover to 6 to match the shared
        hover/selected size exactly; it does not reproduce the press-always-shrinks-to-4 rule,
        since layering that onto the existing checked/hover/pressed trigger combination reliably
        needs more trigger-ordering surgery than this pass covers.
        Navigation buttons: no hover or pressed plate (PipsPagerNavigationButtonBackground* are
        all ControlFillColorTransparentBrush, PipsPager_themeresources.xaml:21-22) hosting
        Fluence FontIcon chevrons; ChevronLeft/Right E76B/E76C when horizontal and
        ChevronUp/Down E70E/E70D when vertical. Buttons default Collapsed per WinUI, show
        always for Visible, and show only while the pointer is over the pager for
        VisibleOnPointerOver.
        The pip ToggleButtons are generated in code into PART_PipsHost (see PipsPager.cs and
        the RatingControl PART_StarsPanel precedent). Every page gets a pip; PART_PipsScrollViewer
        clamps the run to MaxVisiblePips boxes along the orientation axis and PipsPager.cs drives
        its offset, so a long page count scrolls at the viewport edges instead of re-rendering a
        window. WinUI's edge-pip scale-down animation is a deliberate omission.
    -->

    <!--
        The 20x20 pip box below is mirrored in code by PipsPager.PipBoxSize, which the viewport
        sizing and the scroll offsets are computed from. A style that replaces this key under the
        same name has to keep the same box size, or the run scrolls by a stride that does not match
        what it renders.
    -->
    <Style x:Key="PipsPagerPipStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid Background="{TemplateBinding Background}">
                        <Ellipse
                            x:Name="Pip"
                            Width="4"
                            Height="4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--
                            Pip size morph (rest 4 / hover 5 / selected 6), ToggleSwitch.xaml knob
                            precedent: Width/Height animate over 83ms on the 0,0,0,1 spline
                            (Typography.xaml motion tokens ControlFasterAnimationDuration +
                            ControlFastOutSlowInKeySpline; storyboard attributes need literal
                            values). Brush roles keep the committed neutral strong-fill mapping.
                            Hover sizing applies only to unchecked pips and is declared before the
                            IsChecked trigger, so checking a hovered pip lets the 6px selected
                            storyboard begin last and win the size handoff.
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Pip" Property="Fill" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pip" Storyboard.TargetProperty="Width">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.083"
                                                Value="6" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pip" Storyboard.TargetProperty="Height">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.083"
                                                Value="6" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pip" Storyboard.TargetProperty="Width">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.083"
                                                Value="4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pip" Storyboard.TargetProperty="Height">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.083"
                                                Value="4" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Pip" Property="Fill" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pip" Property="Fill" Value="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pip" Storyboard.TargetProperty="Width">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.083"
                                                Value="6" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pip" Storyboard.TargetProperty="Height">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.083"
                                                Value="6" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pip" Storyboard.TargetProperty="Width">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.083"
                                                Value="4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pip" Storyboard.TargetProperty="Height">
                                            <SplineDoubleKeyFrame
                                                KeySpline="0,0,0,1"
                                                KeyTime="0:0:0.083"
                                                Value="4" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Pip" Property="Fill" Value="{DynamicResource ControlStrongFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Width" Value="20" />
    </Style>

    <Style x:Key="PipsPagerNavigationButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Foreground" Value="{DynamicResource ControlStrongFillColorDefaultBrush}" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="ButtonPlate"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--
                            ButtonPlate's Background stays at the base TemplateBinding (Transparent):
                            ControlFillColorTransparentBrush is #00FFFFFF, the same zero-alpha value, so
                            a hover/pressed Background setter here would be a no-op. Only Foreground
                            changes.
                        -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ControlStrongFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Width" Value="20" />
    </Style>

    <Style TargetType="{x:Type controls:PipsPager}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <!--
            IsTabStop=False: the pager itself must not be a tab stop. Keyboard focus belongs
            to the generated pip buttons and the navigation chevrons. See BreadcrumbBar.xaml
            for the same pattern.
        -->
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PipsPager}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <StackPanel Orientation="{TemplateBinding Orientation}">
                            <Button
                                x:Name="PART_PreviousButton"
                                AutomationProperties.Name="Previous page"
                                Style="{StaticResource PipsPagerNavigationButtonStyle}"
                                ToolTip="Previous page"
                                Visibility="Collapsed">
                                <controls:FontIcon
                                    x:Name="PreviousGlyph"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                    Glyph="&#xE76B;"
                                    IconFontSize="8"
                                    IsHitTestVisible="False" />
                            </Button>
                            <!--
                                Pip ToggleButtons are generated in code via UpdatePips() in
                                OnApplyTemplate, one per page. The viewport keeps the run to
                                MaxVisiblePips boxes: PipsPager.cs writes MaxWidth (horizontal) or
                                MaxHeight (vertical) and owns the offset, so the scroll bars stay
                                Hidden (Hidden still scrolls, Disabled would not) and pixel offsets
                                need CanContentScroll=False. Focusable=False keeps the viewport out
                                of the tab order; the pips and the chevrons are the focusable parts.
                            -->
                            <ScrollViewer
                                x:Name="PART_PipsScrollViewer"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                CanContentScroll="False"
                                Focusable="False"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden">
                                <StackPanel x:Name="PART_PipsHost" Orientation="{TemplateBinding Orientation}" />
                            </ScrollViewer>
                            <Button
                                x:Name="PART_NextButton"
                                AutomationProperties.Name="Next page"
                                Style="{StaticResource PipsPagerNavigationButtonStyle}"
                                ToolTip="Next page"
                                Visibility="Collapsed">
                                <controls:FontIcon
                                    x:Name="NextGlyph"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                    Glyph="&#xE76C;"
                                    IconFontSize="8"
                                    IsHitTestVisible="False" />
                            </Button>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="NextGlyph" Property="Glyph" Value="&#xE70D;" />
                            <Setter TargetName="PreviousGlyph" Property="Glyph" Value="&#xE70E;" />
                        </Trigger>
                        <Trigger Property="PreviousButtonVisibility" Value="Visible">
                            <Setter TargetName="PART_PreviousButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="PreviousButtonVisibility" Value="VisibleOnPointerOver" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_PreviousButton" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="NextButtonVisibility" Value="Visible">
                            <Setter TargetName="PART_NextButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="NextButtonVisibility" Value="VisibleOnPointerOver" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_NextButton" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
