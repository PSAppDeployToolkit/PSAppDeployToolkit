<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Fluence.Wpf.Controls">

    <!--
        SlideNavigationPresenter template.
        Authority: WinUI 3 SlideNavigationTransitionInfo (dxaml/phone/lib/ThemeTransitions.cpp),
        the transition a WinUI Frame plays for a horizontal navigation between peers. WinUI runs
        the outgoing page and the incoming page as two separate storyboards that overlap, so the
        template carries two presenters: PART_PreviousPresenter holds the content that is leaving
        while PART_CurrentPresenter carries the content that has arrived. SlideNavigationPresenter
        owns the timings, offsets, and key splines; the template only supplies the parts.
        Both presenters share one cell, the outgoing one painted after the incoming one so the
        page that is leaving stays on top for its 150 ms, and both are clipped to the presenter
        bounds so a sliding page cannot paint outside the host.
    -->

    <Style TargetType="{x:Type controls:SlideNavigationPresenter}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SlideNavigationPresenter}">
                    <Grid
                        Background="{TemplateBinding Background}"
                        ClipToBounds="True"
                        UseLayoutRounding="True">
                        <ContentPresenter
                            x:Name="PART_CurrentPresenter"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}">
                            <ContentPresenter.RenderTransform>
                                <TranslateTransform x:Name="PART_CurrentTranslate" />
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                        <!--  The outgoing item is presented with the same template contract as the incoming one. Without these three bindings a data item with a ContentTemplate falls back to ContentPresenter's default template and renders its ToString() for the whole exit slide.  -->
                        <ContentPresenter
                            x:Name="PART_PreviousPresenter"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{x:Null}"
                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                            IsHitTestVisible="False"
                            Opacity="0">
                            <ContentPresenter.RenderTransform>
                                <TranslateTransform x:Name="PART_PreviousTranslate" />
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
