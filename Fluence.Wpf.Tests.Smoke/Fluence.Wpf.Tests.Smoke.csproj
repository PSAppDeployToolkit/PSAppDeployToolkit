<!--
    Plain Microsoft.NET.Sdk rather than the WindowsDesktop one the other projects use: that SDK
    exists for net472, and this lane targets net8.0-windows only, where UseWPF is enough.
  -->
<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The net8.0-windows smoke lane. The library ships three target frameworks and
    Fluence.Wpf.Tests covers two of them; this project loads the third, which is the one
    AGENTS.md designates for PowerShell 7 in-process consumption and the only one that pulls
    WinRT.Runtime.dll and Microsoft.Windows.SDK.NET.dll. It deliberately references the library
    and nothing else: the demo projects do not target net8, and a smoke lane that needed them
    would be a second full suite rather than a check that the shipped binary loads and works.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>Fluence.Wpf.Tests.Smoke</RootNamespace>
    <AssemblyName>Fluence.Wpf.Tests.Smoke</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <NoWarn>$(NoWarn);CS1591;CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fluence.Wpf\Fluence.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
